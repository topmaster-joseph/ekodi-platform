</style><script id="mission-pay-inline-script-v1">(()=>{const sheet=document.querySelector('[data-mission-pay-sheet]');if(!sheet)return;const amount=()=>String(document.querySelector('[data-trip-fee]')?.textContent||'50,000원').trim();const account=()=>String(sheet.querySelector('[data-mission-pay-account]')?.textContent||'100-033-234271').trim();const status=()=>sheet.querySelector('[data-mission-pay-status]');const copy=async(v,m)=>{try{await navigator.clipboard.writeText(v)}catch{const t=document.createElement('textarea');t.value=v;document.body.append(t);t.select();document.execCommand('copy');t.remove()}const s=status();if(s)s.textContent=m};const open=()=>{sheet.hidden=false;document.body.classList.add('mission-pay-open');sheet.querySelector('[data-mission-pay-amount]').textContent=amount();setTimeout(()=>sheet.querySelector('[data-mission-copy-account]')?.focus(),0)};const close=()=>{sheet.hidden=true;document.body.classList.remove('mission-pay-open')};document.addEventListener('click',async e=>{const pay=e.target.closest('[data-mission-pay-open],[data-mission-pay-close],[data-mission-copy-account],[data-mission-copy-payment]');if(!pay)return;e.preventDefault();e.stopImmediatePropagation();if(pay.matches('[data-mission-pay-open]'))open();else if(pay.matches('[data-mission-pay-close]'))close();else if(pay.matches('[data-mission-copy-account]'))await copy(account().replace(/-/g,''),'계좌번호를 복사했습니다.');else await copy('참가비 '+amount()+' · 신한은행 '+account(),'납부 금액과 계좌를 복사했습니다.')},true);document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!sheet.hidden)close()});const appStatus=document.querySelector('[data-application-status]');if(appStatus)new MutationObserver(()=>{if(appStatus.dataset.state==='success'&&!document.querySelector('.mission-pay-after')){const b=document.createElement('button');b.type='button';b.className='apply-submit mission-pay-after';b.dataset.missionPayOpen='';b.textContent='참가비 바로 납부하기';appStatus.insertAdjacentElement('afterend',b)}}).observe(appStatus,{attributes:true,childList:true,subtree:true});})();</script></body></html>