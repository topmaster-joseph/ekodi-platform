{
  "version": 4,
  "domainPattern": "{tenant}.ekodi.kr/ai",
  "namespace": {
    "domain": "ekodi.kr/ai",
    "purpose": "AI gateway plus legacy execution aliases; customer/workspace identity stays on canonical ekodi.kr paths",
    "productHub": "https://ekodi.kr/ekodibiz/marketing-ai",
    "canonicalHost": "ekodi.kr",
    "engineDomain": "ekodi.kr/marketing",
    "aiGateway": "ekodi.kr/ai",
    "providerTopologyVisibleToOrdinaryUsers": false
  },
  "hub": {
    "domain": "ekodi.kr/marketing",
    "project": "marketing-ai",
    "role": "common_engine",
    "canonicalProductUrl": "https://ekodi.kr/ekodibiz/marketing-ai"
  },
  "policy": {
    "organizationWorkspace": {
      "dedicatedEkodiDomain": false,
      "pattern": "{organization}.ekodi.kr/ai",
      "canonicalPattern": "https://ekodi.kr/{public_namespace}/marketing",
      "legacyExecutionAliasPattern": "{organization}.ekodi.kr/ai"
    },
    "storeBasic": {
      "dedicatedEkodiDomain": false,
      "access": "canonical workspace marketing path"
    },
    "storePlus": {
      "dedicatedEkodiDomain": false,
      "pattern": "{store}.ekodi.kr/ai",
      "customDomain": false,
      "canonicalPattern": "https://ekodi.kr/{public_namespace}/marketing",
      "legacyExecutionAliasPattern": "{store}.ekodi.kr/ai"
    },
    "storePro": {
      "dedicatedEkodiDomain": false,
      "pattern": "{store}.ekodi.kr/ai",
      "customDomain": true,
      "includedCustomDomains": 1,
      "canonicalPattern": "https://ekodi.kr/{public_namespace}/marketing",
      "legacyExecutionAliasPattern": "{store}.ekodi.kr/ai"
    },
    "customDomain": {
      "ownership": "customer",
      "registrationIncluded": false,
      "mappingOnly": true,
      "examples": [
        "ai.customer-domain.com",
        "marketing.customer-domain.com"
      ],
      "note": "EKODI maps the customer-owned hostname to the same Pro workspace; domain ownership is not transferred to EKODI."
    }
  },
  "tenants": [
    {
      "tenant": "jadam",
      "tenantType": "store",
      "name": "자담치킨 목포대점",
      "project": "marketing-ai-jadam",
      "domain": "ekodi.kr/jadam/marketing",
      "landingPath": "/",
      "domainEntitlement": "grandfathered",
      "visibility": "private",
      "privateSiteDomain": "ekodi.kr/jadam",
      "accessRealm": "jadam-client",
      "accessPolicy": "pre_registered_customer_only",
      "legacyDomains": [
        "ekodi.kr/jadam",
        "ekodi.kr/marketing/jadam"
      ],
      "customDomains": [],
      "canonicalUrl": "https://ekodi.kr/jadam/marketing",
      "domainRole": "legacy_execution_alias",
      "executionAlias": "ekodi.kr/jadam/marketing"
    },
    {
      "tenant": "pizzamaru",
      "tenantType": "store",
      "name": "피자마루 목포대점",
      "project": "marketing-ai-pizzamaru",
      "domain": "ekodi.kr/pizzamaru/marketing",
      "landingPath": "/",
      "domainEntitlement": "grandfathered",
      "legacyDomains": [
        "ekodi.kr/pizzamaru",
        "ekodi.kr/marketing/pizzamaru"
      ],
      "customDomains": [],
      "canonicalUrl": "https://ekodi.kr/pizzamaru/marketing",
      "domainRole": "legacy_execution_alias",
      "executionAlias": "ekodi.kr/pizzamaru/marketing"
    },
    {
      "tenant": "yogurt",
      "tenantType": "store",
      "name": "요거트퍼플 목포대점",
      "project": "marketing-ai-yogurtpurple",
      "domain": "ekodi.kr/yogurt/marketing",
      "landingPath": "/",
      "domainEntitlement": "grandfathered",
      "legacyDomains": [
        "ekodi.kr/yogurt",
        "ekodi.kr/marketing/yogurt"
      ],
      "customDomains": [],
      "canonicalUrl": "https://ekodi.kr/yogurt/marketing",
      "domainRole": "legacy_execution_alias",
      "executionAlias": "ekodi.kr/yogurt/marketing"
    },
    {
      "tenant": "cgma",
      "tenantType": "organization",
      "name": "청계면상인회",
      "project": "cheonggye-market",
      "domain": "ekodi.kr/cgma/marketing",
      "landingPath": "/market-ai",
      "domainEntitlement": "organization",
      "visibility": "private",
      "legacyDomains": [
        "ekodi.kr/cgma",
        "ekodi.kr/cheonggye/marketing"
      ],
      "customDomains": [],
      "platformSitePath": "/cgma",
      "publicSiteDomain": "cgma.or.kr",
      "canonicalUrl": "https://ekodi.kr/cgma/marketing",
      "domainRole": "legacy_execution_alias",
      "executionAlias": "ekodi.kr/cgma/marketing"
    }
  ],
  "internalConsumers": [
    {
      "id": "ekodibiz",
      "workspaceType": "tenant",
      "workspaceKey": "ekodibiz",
      "tenant": "ekodibiz",
      "name": "에코디비즈",
      "entryDomain": "ekodi.kr",
      "entryUrl": "https://ekodi.kr/ekodibiz/marketing-ai",
      "templateKey": "service_b2b",
      "role": "first_party_customer",
      "dedicatedEkodiDomain": false,
      "engineUrl": "https://ekodi.kr/marketing/"
    }
  ],
  "domainPatternRole": "legacy_execution_alias_only",
  "canonicalPattern": "https://ekodi.kr/{public_namespace}/marketing"
}
