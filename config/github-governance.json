{
  "version": "1.0.0",
  "repository": "topmaster-joseph/ekodi-platform",
  "defaultBranch": "main",
  "branchProtection": {
    "required": true,
    "requirePullRequest": true,
    "requiredApprovingReviewCount": 0,
    "enforceAdmins": true,
    "requireBranchesUpToDate": true,
