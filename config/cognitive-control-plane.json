{
  "version": 2,
  "status": "enforced-foundation",
  "architecture": {
    "controlPlane": "cognitive-control",
    "governancePlane": "policy-and-promotion",
    "executionPlane": "isolated-work-and-runtime",
    "dataPlane": "portable-data-and-traffic",
    "principle": "control-decides-governance-authorizes-execution-acts-data-remains-bounded"
  },
  "planes": {
    "control": {
      "purpose": "Intent interpretation, planning, agent routing, reconciliation and observation",
      "productionMutation": "forbidden-directly",
      "providerNeutral": true,
      "mayRequestPromotion": true,
      "mayAuthorizeOwnRequest": false
    },
    "governance": {
      "purpose": "Policy-as-code, approval, security gates, artifact identity, audit and promotion authorization",
      "productionMutation": "guarded-controllers-only",
      "independentFromModelProvider": true,
      "failClosedForUnknownPolicy": true
    },
    "execution": {
      "purpose": "Human and AI work in isolated branches, worktrees, staging and bounded runtime executors",
      "productionMutation": "application-promotion-only",
      "isolatedBranchRequiredForSourceChange": true,
      "isolatedRuntimeRequiredForUntrustedExecution": true
    },
    "data": {
      "purpose": "Identity, records, files, cache, queues and public delivery behind portable adapters",
      "contract": "config/data-plane-contract.json",
      "crossWorkspaceDefault": "deny",
      "productionDataInDevelopment": false,
      "productionSchemaMutation": "governed-additive-migration-only"
    }
  },
  "environments": {
    "development": {
      "accountProfile": "development",
      "physicalBoundary": "separate-development-account",
      "productionTraffic": false,
      "productionData": false,
      "sourceMutation": "isolated-branch-only"
    },
    "verification": {
      "accountProfile": "development",
      "physicalBoundary": "separate-development-account",
      "logicalBoundary": "staging-preview",
      "productionTraffic": false,
      "immutableCandidateRequired": true,
      "destructiveTestingAllowedOnlyOnIsolatedState": true
    },
    "production": {
      "accountProfile": "production",
      "physicalBoundary": "separate-production-account",
      "realUserTraffic": true,
      "directMutation": false,
      "promotionOnly": true,
      "runtimeMutation": "immutable-application-promotion-only",
      "dataSchemaMutation": "governed-additive-migration-only",
      "rebuildOnPromotion": false
    }
  },
  "promotion": {
    "canonicalPath": ["development", "verification", "production"],
    "buildOnce": true,
    "rebuildOnPromotion": false,
    "immutableArtifactRequired": true,
    "artifactScope": "application-bundle-and-static-assets",
    "environmentBindingsExcluded": ["secrets", "database-bindings", "routes", "runtime-vars"],
    "artifactIdentity": ["sha256", "git-commit", "provider-version-id"],
    "requiredGates": [
      "source-isolation",
      "build",
      "tests",
      "security",
      "policy",
      "staging-smoke",
      "artifact-identity",
      "release-authorization",
      "audit"
    ],
    "rollback": "previous-verified-artifact-only",
    "rollbackRequiresHumanGate": true
  },
  "migration": {
    "productionSchema": "additive-only-by-default",
    "destructiveSchema": "human-gate-separate-plan",
    "requiredGates": [
      "additive-schema-validation",
      "verification",
      "staging-smoke",
      "recovery-point",
      "release-authorization",
      "audit"
    ],
    "recovery": "capture-before-production-migration",
    "productionDataCopyToDevelopment": false
  },
  "authority": {
    "taskOwner": "ekodi_orchestrator",
    "entryAiRole": "entry_point_and_bounded_participant",
    "finalPlatformAuthority": "ekodi_platform_super_administrator",
    "ordinaryUserApprovalScope": "delegated_workspace_or_resource_only",
    "aiMaySelfExpandAuthority": false,
    "unknownActorAuthority": "deny",
    "unknownEnvironment": "deny",
    "unknownPlane": "deny",
    "productionDeploymentOrPromotion": "platform-super-admin-gate",
    "productionSchemaMigration": "platform-super-admin-gate",
    "productionSecretChange": "platform-super-admin-gate",
    "productionDnsChange": "platform-super-admin-gate",
    "destructiveProductionDataChange": "platform-super-admin-gate",
    "constitutionOrPlatformPolicyChange": "platform-super-admin-gate",
    "coreIdentityOrAuthorizationChange": "platform-super-admin-gate",
    "highValueFinancialCommitment": "platform-super-admin-gate",
    "legalContractExecution": "platform-super-admin-gate",
    "domainServiceShutdownOrOwnershipTransfer": "platform-super-admin-gate",
    "materialExternalPublicationOrCommitment": "platform-super-admin-gate",
    "repositoryForcePush": "platform-super-admin-gate",
    "repositoryDelete": "platform-super-admin-gate",
    "productionRollback": "platform-super-admin-gate"
  },
  "audit": {
    "requiredForMutation": true,
    "appendOnlyPreferred": true,
    "minimumFields": ["request_id", "actor", "intent", "target", "policy_version", "decision", "artifact_id", "timestamp"],
    "retainDecisionEvidence": true
  },
  "reconciliation": {
    "enabled": true,
    "desiredStateSource": "versioned-policy-and-release-manifests",
    "driftAction": "detect-report-and-reconcile-through-guarded-path",
    "directEmergencyMutation": false
  }
}
