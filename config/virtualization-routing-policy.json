{
  "schemaVersion": 1,
  "policyId": "EKODI-VIRTUALIZATION-ROUTING-001",
  "status": "enforced",
  "owner": "ekodi-orchestrator",
  "constitutionalPolicy": "VIRTUALIZATION-SOVEREIGNTY-001",
  "rule": "browser-and-surface-validation-must-use-ekodi-native-routes-in-fixed-order-before-any-external-fallback",
  "taskClasses": {
    "browser-ui-validation": [
      "ekodi-background-browser-worker",
      "ekodi-native-remote-computer",
      "autonomous-execution-fabric"
    ],
    "synthetic-surface-verification": [
      "ekodi-background-browser-worker",
      "ekodi-native-remote-computer",
      "autonomous-execution-fabric"
    ],
    "isolated-browser-execution": [
      "ekodi-background-browser-worker",
      "ekodi-native-remote-computer",
      "autonomous-execution-fabric"
    ],
    "isolated-desktop-execution": [
      "ekodi-native-remote-computer"
    ],
    "computer-use-automation": [
      "ekodi-native-remote-computer"
    ],
    "isolated-engineering-execution": [
      "autonomous-execution-fabric"
    ]
  },
  "nativeProviders": {
    "ekodi-background-browser-worker": {
      "ownership": "ekodi",
      "stateSource": "config/background-browser-worker-policy.json",
      "runtimeProven": true
    },
    "ekodi-native-remote-computer": {
      "ownership": "ekodi",
      "stateSource": "config/remote-computer-execution-policy.json",
      "runtimeProven": false
    },
    "autonomous-execution-fabric": {
      "ownership": "ekodi",
      "stateSource": "config/autonomous-execution-fabric-policy.json",
      "runtimeProven": true
    }
  },
  "selection": {
    "nativeFirst": true,
    "externalForbiddenWhenEligibleNativeHealthy": true,
    "externalFallbackRequiresAllEligibleNativeUnusable": true,
    "failClosedWhenNoEligibleProvider": true,
    "nativeHealthyDefinition": [
      "ready-or-runtime-proven",
      "healthy",
      "capability-matches-task"
    ],
    "externalFallbackRole": "temporary-replaceable-fallback-only",
    "nativeBrowserOrderEnforced": true,
    "externalBrowserServiceDefaultForbidden": true
  },
  "externalFallback": {
    "allowedReasons": [
      "native-capability-not-production-ready",
      "native-capability-unavailable",
      "required-capability-not-yet-implemented",
      "native-capacity-or-runtime-failure"
    ],
    "auditIdRequired": true,
    "nativeCapabilityGapRecordRequired": true,
    "allEligibleNativeFailureEvidenceRequired": true,
    "securityEquivalentOrStrongerRequired": true,
    "paidUpgradeForbidden": true,
    "providerLockInForbidden": true,
    "fallbackDecisionMustBeMachineReadable": true,
    "browserFallbackAdditionalRequirements": [
      "ekodi-background-browser-worker-failure-evidence",
      "ekodi-native-remote-computer-failure-evidence",
      "autonomous-execution-fabric-failure-evidence"
    ]
  },
  "recovery": {
    "successfulFallbackCreatesOrUpdatesNativeGap": true,
    "correctableNativeGapMustNotInterruptUserWorkflow": true,
    "nativeCapabilityMustBeRetriedOnNextEligibleExecution": true,
    "fallbackMustNotBecomeDefaultByHistory": true,
    "externalBrowserFallbackMustCreateNativeRecoveryTask": true
  },
  "constitutionalPolicies": [
    "VIRTUALIZATION-SOVEREIGNTY-001",
    "AUTOMATIC-EXECUTION-LIFECYCLE-001"
  ],
  "automaticExecutionLifecycle": {
    "constitutionalPolicy": "AUTOMATIC-EXECUTION-LIFECYCLE-001",
    "defaultMode": "background-only",
    "userBrowserTabCreation": false,
    "foregroundWindowDefault": false,
    "localOverrideForbidden": true
  }
}
