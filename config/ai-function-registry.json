{
  "version": "1.0.0",
  "updatedAt": "2026-09-10",
  "canonicalUrl": "https://ekodi.kr/ai-function-registry.json",
  "policy": {
    "discovery": "public",
    "execution": "authenticated",
    "principle": "AI 기능 소개와 예시는 공개하고, 실행은 로그인 사용자 누구나 기본적으로 사용할 수 있다. 유료 차등은 접근 차단이 아니라 사용량·대용량·고급 출력·전문 템플릿 같은 부가 기능에 적용한다."
  },
  "functions": [
    {
      "id": "ai.presentation",
      "ownerCapabilityId": "core.documents",
      "name": "발표자료 만들기",
      "summary": "문서 내용을 발표 흐름과 슬라이드로 재구성해 웹에서 바로 발표하고 PDF로 출력합니다.",
      "category": "발표·문서",
      "keywords": ["발표", "발표자료", "슬라이드", "PPT", "프레젠테이션", "사업계획", "설교", "강의", "연구발표"],
      "status": "beta",
      "access": {"discover": "public", "execute": "authenticated"},
      "route": "/my/docs/?mode=presentation",
      "inputs": ["text", "txt", "markdown", "html", "docx", "hwpx"],
      "sourceRetention": ["hwp", "pdf"],
      "outputs": ["web-slides", "pdf"],
      "profiles": ["사업계획", "공모전", "강의", "설교·성경공부", "보고서", "제안서", "연구발표", "행사안내", "마케팅", "상인회·지역활동"],
      "notes": "DOCX·HWPX는 EKODI Docs에서 텍스트 편집 가능한 문서로 가져올 수 있습니다. HWP·PDF는 현재 비공개 원본 연결·보존을 지원하며 직접 내용 추출은 후속 출력/추출 어댑터 범위입니다."
    },
    {
      "id": "ai.document.summarize",
      "ownerCapabilityId": "core.documents",
      "name": "문서 요약",
      "summary": "긴 문서를 자동 분할해 핵심 주장·수치·결정·다음 행동 중심으로 요약합니다.",
      "category": "발표·문서",
      "keywords": ["요약", "문서", "회의록", "보고서", "핵심"],
      "status": "available",
      "access": {"discover": "public", "execute": "authenticated"},
      "route": "/my/docs/?operation=summarize",
      "inputs": ["text", "txt", "markdown", "html", "docx", "hwpx"],
      "outputs": ["editable-document", "docx", "hwpx", "html", "markdown", "txt", "pdf"]
    },
    {
      "id": "ai.document.rewrite",
      "ownerCapabilityId": "core.documents",
      "name": "문서 다듬기",
      "summary": "의미와 사실을 보존하면서 문장을 더 명확하고 자연스럽게 정리합니다.",
      "category": "발표·문서",
      "keywords": ["교정", "다듬기", "문서작성", "글쓰기", "보고서"],
      "status": "available",
      "access": {"discover": "public", "execute": "authenticated"},
      "route": "/my/docs/?operation=rewrite",
      "inputs": ["text", "txt", "markdown", "html", "docx", "hwpx"],
      "outputs": ["editable-document", "docx", "hwpx", "html", "markdown", "txt", "pdf"]
    },
    {
      "id": "ai.navigator",
      "ownerCapabilityId": "core.navigator",
      "name": "AI 길찾기",
      "summary": "무엇을 해야 할지 자연어로 입력하면 적합한 EKODI 기능과 작업 경로를 찾습니다.",
      "category": "AI 안내",
      "keywords": ["AI", "도움", "무엇을", "찾기", "추천", "업무"],
      "status": "available",
      "access": {"discover": "public", "execute": "authenticated"},
      "route": "/my/",
      "inputs": ["intent"],
      "outputs": ["recommended-route", "capability-composition"]
    }
  ]
}
