{
  "schemaVersion": 1,
  "policyId": "REMOTE-COMPUTER-001",
  "status": "enforced-contract",
  "capabilityId": "device.remote-computer",
  "nativeProvider": "ekodi-native-remote-computer",
  "strategy": {
    "nativeFirst": true,
    "externalFallback": true,
    "fallbackMustPreserveOrIncreaseSecurity": true,
    "providerLockInForbidden": true
  },
  "hostBoundary": {
    "observeAllowlist": [
      "computer.system.read",
      "computer.process.list",
      "computer.agent.status"
    ],
    "persistentAgentShell": false,
    "directHostMutation": false,
    "screenCaptureDefault": "disabled",
    "desktopInputDefault": "disabled",
    "credentialCollection": false
  },
  "isolatedExecution": {
    "requiredFor": [
      "computer.files.read",
      "computer.files.write",
      "computer.terminal.exec",
      "computer.desktop.capture",
      "computer.desktop.input"
    ],
    "engineeringMutationMustUseExecutionFabric": true,
    "productionMutationOwnedByReleaseGateway": true,
    "ephemeralWorkspaceRequired": true,
    "productionSecretsForbidden": true
  },
  "deviceEligibility": {
    "automaticExecution": "verified-desktop-pc-only",
    "portableDefault": "excluded",
    "unknownHardwareDefault": "excluded",
    "newNodeDefault": "off"
  },
  "reliability": {
    "heartbeatRequired": true,
    "boundedLease": true,
    "maxAttempts": 3,
    "automaticFailover": true,
    "independentVerificationRequiredForMutation": true
  },
  "learning": {
    "record": [
      "success_rate",
      "latency_ms",
      "failure_code",
      "device_load",
      "provider_id",
      "recovery_result"
    ],
    "routerMayLearn": true,
    "securityBoundaryMayNotBeLoweredByLearning": true
  },
  "adminObservationSurface": {
    "enabled": true,
    "allowedOperations": [
      "computer.agent.status",
      "computer.system.read",
      "computer.process.list"
    ],
    "processProjection": {
      "maximumItems": 20,
      "allowedFields": [
        "id",
        "name",
        "cpuSeconds",
        "memoryMB"
      ],
      "commandLine": false,
      "environment": false
    },
    "forbiddenOperations": [
      "computer.terminal.exec",
      "computer.files.write",
      "computer.desktop.input"
    ]
  }
}
