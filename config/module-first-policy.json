{
  "version": "1.0.0",
  "policyId": "EKODI-MODULE-FIRST-001",
  "status": "enforced",
  "appliesRecursivelyToAllServices": true,
  "principle": "Use a proven complete module through an EKODI adapter before building commodity features from scratch.",
  "decisionOrder": ["existing_ekodi_common_module","free_open_source_complete_module","self_hostable_api_module","thin_ekodi_adapter","custom_development_only_for_missing_capability"],
  "requirements": {
    "preserveEkodiUrlAndUserSurface": true,
    "singleEkodiAuthenticationWhereSupported": true,
    "mobileRequired": true,
    "exportOrMigrationRequired": true,
    "noAds": true,
    "vendorLockInMinimized": true,
    "adminFunctionsPreferSameUserSurface": true,
    "moduleFailureMustNotClaimSuccess": true
  },
  "moduleClasses": {
    "board": {
      "uses": ["citizen_feedback","notice","qna","community"],
      "referenceCandidate": "flarum",
      "adapterContract": ["list","read","create","reply","edit","delete","moderate","attachments"],
      "currentRollout": ["seonammedi.citizen_voice","seonammedi.notice"]
    },
    "accounting": {
      "uses": ["public_ledger","income_expense","evidence","reports"],
      "referenceCandidate": "frappe_books",
      "adapterContract": ["entries","accounts","reports","attachments","roles","export"],
      "currentRollout": ["seonammedi.finance"],
      "deploymentGate": "Do not couple Frappe runtime directly to Cloudflare production until hosting, backup, auth and upgrade operations are verified."
    }
  },
  "migration": {
    "existingPublicUrlsRemainCanonical": true,
    "existingDataMustBePreserved": true,
    "adapterCanChangeWithoutChangingPublicUI": true,
    "dualRunBeforeCutover": true,
    "rollbackRequired": true
  }
}
