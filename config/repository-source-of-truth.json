{
  "schemaVersion": 1,
  "policyId": "REPOSITORY-SOT-001",
  "status": "enforced",
  "canonicalPlatformRepository": "topmaster-joseph/ekodi-platform",
  "rules": {
    "platformCoreChangesDefaultToCanonicalRepository": true,
    "satelliteRepositoryMutationRequiresExplicitOwnedScope": true,
    "duplicateImplementationRequiresCrossRepositoryReview": true,
    "unclassifiedRepositoryWriteForbidden": true,
    "repositoryRoleDoesNotOverrideRuntimeEvidence": true
  },
  "repositories": [
    {
      "name": "topmaster-joseph/ekodi-platform",
      "role": "canonical-platform",
      "mutationMode": "guarded-pr",
      "owns": [
        "platform-core",
        "governance",
        "shared-edge",
        "embedded-services"
      ]
    },
    {
      "name": "topmaster-joseph/ekodi-site",
      "role": "unclassified-satellite",
      "mutationMode": "blocked-pending-scope-verification",
      "relationship": "historical standalone site repository; verify ownership before any new change"
    },
    {
      "name": "topmaster-joseph/ekodi-mall",
      "role": "active-satellite",
      "mutationMode": "scope-specific-guarded-pr",
      "relationship": "cross-repository review required against ekodi-platform/sites/ekodi-mall"
    },
    {
      "name": "topmaster-joseph/ekodi-church",
      "role": "active-satellite",
      "mutationMode": "scope-specific-guarded-pr",
      "relationship": "church-owned implementation; canonical public routing is governed by the platform",
      "approvedConsolidation": {
        "approvalId": "CHURCH-SOURCE-ONE-REPO-20261103",
        "ownerApprovedAt": "2026-11-03",
        "changeClass": "C2-C3",
        "targetCanonicalRepository": "topmaster-joseph/ekodi-platform",
        "targetSourceDirectory": "sites/ekodi-church",
        "preservedPagesProject": "ekodi-church",
        "preservedReleaseWorkflow": ".github/workflows/deploy-ekodi-church-homepage.yml",
        "productionCutover": "pending-guarded-v2-release-and-live-sha-verification",
        "legacyProductionSourceRemainsActive": true,
        "automaticDeletionAuthorized": false,
        "repositorySpecificDeletionApprovalRequired": true
      }
    },
    {
      "name": "topmaster-joseph/jadam-maru",
      "role": "active-customer-site",
      "mutationMode": "scope-specific-guarded-pr",
      "relationship": "customer/site scope only; shared platform contracts remain platform-owned"
    },
    {
      "name": "topmaster-joseph/cheonggye-market",
      "role": "active-community-site",
      "mutationMode": "scope-specific-guarded-pr",
      "relationship": "community/site scope only; shared auth and canonical routing remain platform-owned"
    },
    {
      "name": "topmaster-joseph/cheonggye-merchants-site",
      "role": "active-project-site",
      "mutationMode": "scope-specific-guarded-pr",
      "relationship": "project/site scope only; shared platform contracts remain platform-owned"
    }
  ]
}
