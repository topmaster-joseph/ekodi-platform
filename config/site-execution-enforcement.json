{
  "schemaVersion": 3,
  "policyId": "SITE-EXECUTION-ENFORCEMENT-001",
  "status": "enforced",
  "sourceOfSites": "config/site-lifecycle-registry.json",
  "canonicalHost": "ekodi.kr",
  "scope": {
    "siteClasses": [
      "workspace_user_site"
    ],
    "rootSite": true,
    "allDescendantServicePaths": true,
    "siteOwnedAdmin": true,
    "futureSitesAutoInherit": true,
    "perSiteOptOutAllowed": false
  },
  "canonicalAddressing": {
    "publicPattern": "https://ekodi.kr/{slug}",
    "descendantPattern": "https://ekodi.kr/{slug}/{service}",
    "adminPattern": "https://ekodi.kr/{slug}/admin",
    "featureSubdomainCreationForbidden": true,
    "legacyAliasesAreCompatibilityOnly": true
  },
  "mandatoryContracts": [
    "canonical-apex-path",
    "shared-shell-and-ui-dna",
    "brand-or-service-only-public-header",
    "site-owned-admin-addressability",
    "auth-return-continuity",
    "responsive-mobile-desktop-layout",
    "readability-and-no-clipping",
    "keyboard-and-touch-accessibility",
    "internal-external-link-integrity",
    "loading-error-empty-state-usability",
    "shared-header-footer-language-behavior",
    "central-social-hub-inheritance",
    "no-direct-production-mutation",
    "isolated-branch-and-regression-validation",
    "guarded-staging-before-production"
  ],
  "publicHeader": {
    "internalWorkspaceWordingForbidden": true,
    "forbiddenLabels": [
      "운영공간",
      "operating space",
      "workspace operating space"
    ],
    "brandOrServiceIdentityOnly": true
  },
  "inheritance": {
    "mode": "mandatory-recursive",
    "rootAppliesToAllDescendants": true,
    "childMayTightenButNotRelax": true,
    "adminMayTightenSecurityButNotRelaxAddressingOrUx": true,
    "sharedComponentFixPreferredForSharedDefect": true
  },
  "continuousImprovement": {
    "scheduler": "ekodi-site-improvement-scheduler.js",
    "rootAndDescendantsMustBeInspectedTogether": true,
    "lowTrafficTaskMustUseThisPolicy": true,
    "verifiedNoChangeAllowed": true,
    "dailyBudget": {
      "resetTimeKst": "09:00",
      "timezone": "Asia/Seoul",
      "executionCountPerBudgetDay": 3,
      "basis": "live-server-resource-load",
      "apiUsageExcluded": true,
      "serverLoadCeilingsPercent": {
        "morning": 30,
        "lunch": 60,
        "evening": 90
      },
      "executionWindowsKst": {
        "morning": "09:00-11:59",
        "lunch": "12:00-17:59",
        "evening": "18:00-08:59(next day)"
      },
      "serverMetrics": [
        "current_load",
        "cpu_load_pct",
        "memory_used_pct",
        "active_job_concurrency_pct"
      ],
      "effectiveLoadRule": "max-of-server-metrics",
      "serverTelemetryFreshSeconds": 90,
      "emergencyReservePercent": 10,
      "trafficAware": true,
      "sameSiteRetryBeforeCursorAdvance": true,
      "startBlockedAtOrAboveCeiling": true
    },
    "rootAndDescendantsShareOneExecutionBudget": true,
    "slotExecutionMustRemainLowTrafficGated": true,
    "slotExecutionMustRemainServerLoadGated": true
  },
  "exceptions": {
    "constitutionalBoundaryOnly": true,
    "requiresExplicitRegisteredBoundary": true,
    "pendingCanonicalStates": [
      "hold_existing_url_pending_canonical_decision",
      "preparing_keep_existing"
    ],
    "silentExceptionForbidden": true
  },
  "enforcement": {
    "validator": "scripts/validate-site-execution-enforcement.mjs",
    "tests": [
      "test/site-execution-enforcement.test.mjs"
    ],
    "orchestrationGate": ".github/workflows/ekodi-ai-orchestration-gate.yml",
    "packageScript": "validate:site-execution"
  },
  "changeScopeClassification": {
    "policyId": "SITE-CHANGE-SCOPE-001",
    "status": "enforced",
    "classes": {
      "platform_common": {
        "appliesTo": "all-current-and-future-sites",
        "implementationOwner": "shared-registry-shell-or-common-runtime",
        "perSiteCopyForbidden": true,
        "examples": [
          "canonical-routing",
          "public-access-default",
          "shared-header-footer-behavior",
          "language-readiness",
          "auth-return-continuity",
          "responsive-accessibility",
          "common-admin-addressability"
        ]
      },
      "shared_service_engine": {
        "appliesTo": "all-sites-using-that-engine",
        "implementationOwner": "shared-service-engine",
        "perSiteOverride": "tighten-only",
        "examples": [
          "notice-board",
          "social-channel-preview",
          "broadcast",
          "commerce",
          "finance"
        ]
      },
      "site_specific": {
        "appliesTo": "named-site-only",
        "implementationOwner": "site-module",
        "promotionToCommonRequiredWhenReusableAcrossSites": true
      }
    },
    "classificationRequiredBeforeImplementation": true,
    "commonDefectMustBeFixedAtCommonOwner": true,
    "futureSitesAutoInheritPlatformCommon": true,
    "validatorMustRejectCommonRuleImplementedOnlyAsPerSitePatch": true
  },
  "authenticationEntry": {
    "policyId": "SITE-CENTRAL-AUTH-ENTRY-001",
    "status": "enforced",
    "centralEntry": "https://ekodi.kr/auth/",
    "siteLocalAuthPathForbidden": true,
    "exactInitiatingReturnRequired": true,
    "registeredCustomerDomainReturnAllowed": true,
    "futureSitesAutoInherit": true,
    "perSiteOptOutAllowed": false
  }
}
