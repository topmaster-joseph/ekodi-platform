{
  "version": 1,
  "policyId": "ADMIN-ROLE-NAV-001",
  "authorityModel": "Person + Workspace + Role + Capability",
  "principles": [
    "Administrator navigation is role-specific, not a progressively hidden copy of the platform-super-admin menu.",
    "Every visible working item is a direct route to the requested screen; category labels may group items but do not add an extra click.",
    "Menu projection never widens authorization. Capability checks remain authoritative.",
    "Platform control-plane capabilities never leak into delegated or local operator navigation."
  ],
  "profiles": {
    "platform-super-admin": {
      "surface": "/admin",
      "navigationMode": "eight-platform-control-areas-with-menu-and-detail-routes",
      "groups": [
        {
          "id": "home",
          "labelKo": "홈",
          "purpose": "플랫폼 전체 현황, 알림, 우선 조치"
        },
        {
          "id": "sites",
          "labelKo": "사이트 원장",
          "purpose": "전체 사이트 목록과 각 사이트 관리자(/{site}/admin) 이동"
        },
        {
          "id": "ai",
          "labelKo": "AI 운영",
          "purpose": "AI 운영센터(공급자·연결·라우팅·기록), AI·자동화 정책"
        },
        {
          "id": "services",
          "labelKo": "서비스·엔진",
          "purpose": "서비스·AI·연동 엔진"
        },
        {
          "id": "finance",
          "labelKo": "재무",
          "purpose": "결제·정산, 사용량·비용"
        },
        {
          "id": "ops",
          "labelKo": "운영·안정성",
          "purpose": "운영상태, 자동점검, 배포·장애, 시스템 구조, 실행 인프라"
        },
        {
          "id": "settings",
          "labelKo": "설정·연동",
          "purpose": "공통 UI·디자인, 언어, 외부 연동·API, 저장소"
        },
        {
          "id": "accounts",
          "labelKo": "계정·보안",
          "purpose": "EKODI 계정, 최고관리자, 보안·인증, 감사기록"
        }
      ],
      "leftDetailRule": "Show the active group's menus under the selected control area; the active menu nests its detail routes directly beneath it (group → menu → detail).",
      "serviceGroupRule": "Services & Engines renders the engine catalog as detail routes of one menu; no duplicate top context tab strip.",
      "maySeeControlPlane": true,
      "mayAggregateChildStatus": true,
      "uniqueOwnership": true,
      "legacyDeepLinks": "Previously canonical routes remain accepted as aliases after navigation reclassification.",
      "siteOperationsRule": "Per-site operations (channels, events, members, messages) live only in each site admin (/{site}/admin); the platform admin lists sites and hands off. Platform-global engines (EKODI Books, devotional autopost, channel control center, EKODI Work) are platform services under ADMIN-AUDIENCE-001."
    },
    "delegated-manager": {
      "surfacePattern": "/{site-or-workspace}/admin",
      "navigationMode": "task-groups-with-direct-links",
      "menuIntent": [
        "현황",
        "핵심 운영",
        "콘텐츠·고객",
        "정산·보고",
        "사이트·권한"
      ],
      "mustNotShow": [
        "platform control plane",
        "global deployment",
        "global AI policy",
        "platform-wide administrators",
        "cross-tenant secrets"
      ],
      "maySeeControlPlane": false,
      "mayAggregateChildStatus": "only-with-explicit-parent-capability"
    },
    "local-operator": {
      "surfacePattern": "/{site-or-workspace}/admin",
      "navigationMode": "high-frequency-direct-actions-only",
      "menuIntent": [
        "오늘 할 일",
        "현장 운영",
        "고객·문의",
        "콘텐츠·채널"
      ],
      "mustNotShow": [
        "platform settings",
        "administrator management",
        "security policy",
        "deployment controls",
        "cross-tenant data"
      ],
      "maySeeControlPlane": false,
      "configurationLast": true
    }
  },
  "domainProjections": {
    "workspace": {
      "delegated-manager": [
        "운영",
        "고객·업무",
        "마케팅",
        "경영",
        "운영도구",
        "사이트 관리"
      ],
      "local-operator": [
        "오늘 할 일",
        "소통·콘텐츠",
        "업무처리"
      ]
    },
    "store": {
      "delegated-manager": [
        "현황",
        "주문·매출",
        "메뉴·재고",
        "고객·리뷰",
        "홍보·채널",
        "운영·설정"
      ],
      "local-operator": [
        "오늘 주문",
        "메뉴·품절",
        "고객·리뷰",
        "홍보·채널"
      ]
    },
    "church": {
      "delegated-manager": [
        "현황",
        "교인·돌봄",
        "예배·사역",
        "기록·AI",
        "사이트·권한"
      ],
      "local-operator": [
        "오늘 일정",
        "출석·교인",
        "예배·사역",
        "신청·연락"
      ]
    },
    "trade": {
      "delegated-manager": [
        "현황",
        "거래처",
        "채널·게시",
        "권한"
      ],
      "local-operator": [
        "거래처",
        "게시·문의"
      ]
    }
  }
}
