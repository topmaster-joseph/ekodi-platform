{
  "version": 1,
  "policyId": "ADMIN-ROLE-NAV-001",
  "authorityModel": "Person + Workspace + Role + Capability",
  "principles": [
    "Administrator navigation is role-specific, not a progressively hidden copy of the platform-super-admin menu.",
    "Every visible working item is a direct route to the requested screen; category labels may group items but do not add an extra click.",
    "Menu projection never widens authorization. Capability checks remain authoritative.",
    "Platform control-plane capabilities never leak into delegated or local operator navigation."
  ],
  "profiles": {
    "platform-super-admin": {
      "surface": "/admin",
      "navigationMode": "eleven-distinct-control-areas-with-direct-task-routes",
      "groups": [
        {
          "id": "summary",
          "labelKo": "전체 대시보드",
          "purpose": "전체 지표, 승인 대기, 우선 조치"
        },
        {
          "id": "sites",
          "labelKo": "사이트·브랜드",
          "purpose": "전체 사이트, 브랜드, 준비 사이트"
        },
        {
          "id": "people",
          "labelKo": "회원·관리자·권한",
          "purpose": "회원, 관리자, 역할, 가입 승인"
        },
        {
          "id": "services",
          "labelKo": "서비스·AI",
          "purpose": "서비스·AI·연동 엔진"
        },
        {
          "id": "content",
          "labelKo": "콘텐츠·행사·소통",
          "purpose": "게시물, 행사, 채널, 일정"
        },
        {
          "id": "finance",
          "labelKo": "결제·회계·비용",
          "purpose": "결제, 회계, 사용량과 비용"
        },
        {
          "id": "status",
          "labelKo": "상태·성능·점검",
          "purpose": "서비스 상태, 성능, 자동점검, 구조"
        },
        {
          "id": "releases",
          "labelKo": "배포·장애",
          "purpose": "배포, 변경이력, 장애 대응"
        },
        {
          "id": "devices-agent",
          "labelKo": "기기·에이전트",
          "purpose": "원격 PC, 실행 Agent, POS Agent"
        },
        {
          "id": "settings-records",
          "labelKo": "설정·연동·저장소",
          "purpose": "공통 UI, 언어, API, 저장소, 자동화 정책"
        },
        {
          "id": "security-audit",
          "labelKo": "보안·감사",
          "purpose": "인증·보안 기록, 운영규칙, 변경감사"
        }
      ],
      "leftDetailRule": "Show the active group's high-frequency direct task routes directly under the selected control area.",
      "serviceGroupRule": "Services & AI renders all engine routes as flat direct links and suppresses the duplicate top context tab strip.",
      "maySeeControlPlane": true,
      "mayAggregateChildStatus": true,
      "uniqueOwnership": true,
      "legacyDeepLinks": "Previously canonical routes remain accepted as aliases after navigation reclassification."
    },
    "delegated-manager": {
      "surfacePattern": "/{site-or-workspace}/admin",
      "navigationMode": "task-groups-with-direct-links",
      "menuIntent": [
        "현황",
        "핵심 운영",
        "콘텐츠·고객",
        "정산·보고",
        "사이트·권한"
      ],
      "mustNotShow": [
        "platform control plane",
        "global deployment",
        "global AI policy",
        "platform-wide administrators",
        "cross-tenant secrets"
      ],
      "maySeeControlPlane": false,
      "mayAggregateChildStatus": "only-with-explicit-parent-capability"
    },
    "local-operator": {
      "surfacePattern": "/{site-or-workspace}/admin",
      "navigationMode": "high-frequency-direct-actions-only",
      "menuIntent": [
        "오늘 할 일",
        "현장 운영",
        "고객·문의",
        "콘텐츠·채널"
      ],
      "mustNotShow": [
        "platform settings",
        "administrator management",
        "security policy",
        "deployment controls",
        "cross-tenant data"
      ],
      "maySeeControlPlane": false,
      "configurationLast": true
    }
  },
  "domainProjections": {
    "workspace": {
      "delegated-manager": [
        "운영",
        "고객·업무",
        "마케팅",
        "경영",
        "운영도구",
        "사이트 관리"
      ],
      "local-operator": [
        "오늘 할 일",
        "소통·콘텐츠",
        "업무처리"
      ]
    },
    "store": {
      "delegated-manager": [
        "현황",
        "주문·매출",
        "메뉴·재고",
        "고객·리뷰",
        "홍보·채널",
        "운영·설정"
      ],
      "local-operator": [
        "오늘 주문",
        "메뉴·품절",
        "고객·리뷰",
        "홍보·채널"
      ]
    },
    "church": {
      "delegated-manager": [
        "현황",
        "교인·돌봄",
        "예배·사역",
        "기록·AI",
        "사이트·권한"
      ],
      "local-operator": [
        "오늘 일정",
        "출석·교인",
        "예배·사역",
        "신청·연락"
      ]
    },
    "trade": {
      "delegated-manager": [
        "현황",
        "거래처",
        "채널·게시",
        "권한"
      ],
      "local-operator": [
        "거래처",
        "게시·문의"
      ]
    }
  }
}
