{
  "schemaVersion": 1,
  "policyId": "EKODI-CF-ACCOUNT-POOL-001",
  "status": "enforced",
  "effectiveDate": "2026-09-28",
  "constitutionalAuthority": [
    "CONSTITUTION.md#0-supreme-ecosystem-attributes-constitution",
    "CONSTITUTION.md#1b-sovereign-autonomous-operations-constitution",
    "CONSTITUTION.md#5-provider-constitution"
  ],
  "principle": "one-paid-primary-many-bounded-auxiliaries-no-security-failover",
  "accounts": {
    "primary": {
      "identityEmail": "topmaster.joseph@gmail.com",
      "planClass": "workers-paid",
      "accountIdEnv": "CLOUDFLARE_ACCOUNT_ID",
      "tokenEnv": "CLOUDFLARE_API_TOKEN",
      "role": "production-critical-owner",
      "canonicalDomainAuthority": true,
      "sourceOfTruthEligible": false
    },
    "auxiliary": {
      "identityEmail": "joseph@ekodi.kr",
      "planClass": "free-preferred",
      "accountIdEnv": "CLOUDFLARE_AUXILIARY_ACCOUNT_ID",
      "tokenEnv": "CLOUDFLARE_AUXILIARY_API_TOKEN",
      "legacyAccountIdEnv": "CLOUDFLARE_DEVELOPMENT_ACCOUNT_ID",
      "legacyTokenEnv": "CLOUDFLARE_DEVELOPMENT_API_TOKEN",
      "role": "bounded-noncritical-execution",
      "canonicalDomainAuthority": false,
      "sourceOfTruthEligible": false
    }
  },
  "routing": {
    "primaryOnly": [
      "production-release",
      "production-domain",
      "production-dns",
      "auth",
      "identity",
      "authorization",
      "secrets",
      "payments",
      "finance",
      "orders",
      "production-admin-control",
      "production-d1-migration",
      "root-security"
    ],
    "auxiliaryPreferred": [
      "development",
      "staging",
      "batch",
      "backup",
      "snapshot",
      "diagnostics",
      "synthetic-verification",
      "noncritical-analysis",
      "nonproduction-ai"
    ],
    "auxiliaryForbidden": [
      "ekodi.kr-canonical-domain",
      "production-zone-ownership",
      "production-auth-state",
      "production-payment-state",
      "production-finance-state",
      "production-order-state",
      "production-secret-authority",
      "production-identity-authority"
    ]
  },
  "failover": {
    "productionCriticalToAuxiliary": "forbidden",
    "noncriticalAuxiliaryToPrimary": "allowed-only-when-primary-budget-policy-allows",
    "missingAuxiliaryCredentials": "degrade-or-run-on-primary-with-budget-guard",
    "missingPrimaryCredentialsForCriticalWork": "fail-closed"
  },
  "quota": {
    "primary": {
      "strategy": "paid-core-with-included-capacity-guard",
      "warningPercent": 70,
      "protectPercent": 90
    },
    "auxiliary": {
      "strategy": "free-first",
      "warningPercent": 60,
      "conservePercent": 75,
      "protectPercent": 85,
      "survivalPercent": 90
    }
  },
  "security": {
    "leastPrivilegeRequired": true,
    "crossAccountServiceBindingAssumed": false,
    "crossAccountCalls": "https-api-only-with-purpose-scoped-token-when-needed",
    "sharedSecretNamesForbidden": true,
    "ownerApprovalRequiredForAccountMembershipOrBillingChange": true
  },
  "serviceScope": {
    "inheritance": "all-current-and-future-sites-services-subsurfaces",
    "localOverride": "forbidden",
    "newServiceDefault": "primary-for-production-auxiliary-for-nonproduction"
  }
}
