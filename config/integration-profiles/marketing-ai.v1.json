{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "EKODIIntegrationProfile",
  "profile_id": "marketing-ai",
  "version": "1.0.0",
  "status": "draft",
  "owner": "EKODI Integration Core",
  "purpose": "Defines the machine-verifiable contact boundary between EKODI Platform and independently implemented Marketing AI services.",
  "implementation_freedom": {
    "language": true,
    "framework": true,
    "internal_database": true,
    "internal_schema": true,
    "internal_ai_workflow": true,
    "deployment_platform": true
  },
  "canonical_context": {
    "required": ["workspace_id", "user_id", "tenant_id", "service_id"],
    "source_of_truth": {
      "identity": "EKODI Core",
      "workspace": "EKODI Core",
      "membership": "EKODI Core",
      "role_permission": "EKODI Core"
    },
    "rule": "A service may cache or map EKODI canonical identifiers, but must not redefine them as an independent canonical source of truth."
  },
  "service_owned_data": [
    "marketing_profile_extension",
    "diagnosis",
    "marketing_plan",
    "content",
    "approval_workflow",
    "publish_export_state",
    "performance_metric",
    "next_action_recommendation"
  ],
  "discovery": {
    "manifest_path": "/.well-known/ekodi-integration.json",
    "health_path": "/health"
  },
  "manifest_contract": {
    "schema_version": "1",
    "required_fields": [
      "schema_version",
      "service_id",
      "profile",
      "profile_version",
      "capabilities",
      "identity_context",
      "endpoints"
    ],
    "profile": "marketing-ai",
    "profile_version": "1.0.0",
    "required_identity_context": ["workspace_id", "user_id", "tenant_id", "service_id"],
    "required_capabilities": [
      "diagnosis",
      "planner",
      "content_generation",
      "approval",
      "export",
      "performance"
    ]
  },
  "security": {
    "transport": "https",
    "production_auth": "EKODI-owned integration authentication profile; never vendor-defined as the platform authority",
    "conformance_runner_auth": "EKODI_INTEGRATION_TEST_KEY",
    "redirect_policy": "manual",
    "private_target_policy": "deny"
  },
  "conformance": {
    "phase": "contact-boundary-v1",
    "checks": [
      "target_url_security",
      "manifest_reachable",
      "manifest_shape",
      "profile_match",
      "identity_context_match",
      "capabilities_match",
      "health_reachable"
    ],
    "passing_rule": "All required checks must PASS."
  }
}
