    {"rank": 3, "path": "governance/architecture/sovereign-autonomous-operations.v1.json", "kind": "sovereign-operations"},
    {"rank": 4, "path": "config/ai-change-orchestration-policy.json", "kind": "change-orchestration"},
    {"rank": 5, "path": "config/autonomous-technology-evolution-policy.json", "kind": "technology-evolution"},
    {"rank": 6, "path": "config/ecosystem-services.json", "kind": "service-registry"},
    {"rank": 7, "path": "platform-route-registry.js", "kind": "runtime-route-registry"}
  ],
  "currentFacts": {
    "generation": 10,
    "generationName": "Self-Architecture Optimization",
    "scaleTier": "S0",
    "canonicalWebRoot": "https://ekodi.kr",
    "canonicalAdminPath": "https://ekodi.kr/admin",
    "canonicalPersonalPath": "https://ekodi.kr/my",
    "canonicalMcpPath": "https://ekodi.kr/mcp",
