  "validationBindings": [
    "current generation and scale tier must match the evolution model",
    "free-or-low-cost-first must remain active at S0",
    "autonomous agents may not mutate production directly",
    "production promotion remains independently governed",
    "direct push to main remains forbidden",
    "new paid commitments remain human-gated"
  ]
