  "interpretationRules": {
    "unlistedDocumentsMayDescribeHistory": true,
    "unlistedDocumentsMayOverrideCanonicalFacts": false,
    "legacySubdomainReferencesAreNonAuthoritative": true,
    "autonomousPlannerMustUseAuthorityPrecedence": true,
    "runtimeEvidenceBeatsDescriptiveDocumentationForCurrentState": true,
    "uncertainOrConflictingCurrentStateMustBeReportedAsConfirmationRequired": true
