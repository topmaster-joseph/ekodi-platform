{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ekodi.kr/marketing-ai/entitlement-v1.schema.json",
  "title": "EKODI Marketing AI Entitlement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entitlement_id",
    "subject_scope",
    "plan_id",
    "capabilities",
    "provider_selector",
    "enabled"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "entitlement_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "subject_scope": {
      "enum": ["individual", "institution", "organization"]
    },
    "plan_id": { "type": "string", "minLength": 1, "maxLength": 96 },
    "enabled": { "type": "boolean" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "content.generate",
          "campaign.plan",
          "audience.segment",
          "channel.optimize",
          "analytics.report",
          "publish.execute"
        ]
      }
    },
    "provider_selector": {
      "oneOf": [
        { "enum": ["any_certified", "ekodi-default"] },
        {
          "type": "string",
          "pattern": "^provider:[a-z0-9][a-z0-9-]{2,63}$"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          }
        }
      ]
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "period": { "enum": ["day", "month", "billing-cycle"] },
        "requests": { "type": "integer", "minimum": 0 },
        "units": { "type": "integer", "minimum": 0 }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "integer", "minimum": 1 },
        "window_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 96 }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_regions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 32 }
        },
        "training_use_allowed": { "type": "boolean" },
        "payload_persistence_allowed": { "type": "boolean" },
        "sensitive_data_allowed": { "type": "boolean" }
      }
    },
    "valid_from": { "type": ["string", "null"], "format": "date-time" },
    "valid_until": { "type": ["string", "null"], "format": "date-time" }
  }
}
