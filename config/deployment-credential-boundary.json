{
  "schemaVersion": 1,
  "policyId": "EXEC-CRED-001",
  "status": "enforced",
  "generation": 10,
  "purpose": "Keep production deployment authority outside autonomous execution sandboxes while allowing the independent release controller to perform narrowly scoped provider operations.",
  "sandbox": {
    "productionCredentials": "forbidden",
    "longLivedCredentials": "forbidden",
    "credentialInjection": "forbidden",
    "providerMutation": "forbidden",
    "secretAbsenceRuntimeProofRequired": true
  },
  "releaseController": {
    "boundary": "github-hosted-ephemeral-vm",
    "role": "independent-privileged-release-controller",
    "directAgentCredentialAccess": false,
    "productionMutationRequiresGuardedRelease": true,
    "cloudflare": {
      "ciAuthenticationMode": "scoped-api-token",
      "tokenStorage": "github-actions-secret",
      "sandboxPropagation": "forbidden",
      "minimumScopeForExistingWorkerRelease": "worker-editor",
      "resourceScope": "only-required-account-and-workers",
      "workloadIdentityUpgrade": "prefer-official-oidc-or-workload-identity-when-noninteractive-wrangler-supports-it"
    }
  },
  "evidence": {
    "runtimeSecretAbsenceMechanism": "sentinel-not-forwarded-into-rootless-container",
    "controllerWorkflow": ".github/workflows/deploy-cloudflare-secret-manager.yml",
    "sandboxWorkflow": ".github/workflows/ekodi-ai-orchestration-gate.yml",
    "validator": "scripts/validate-deployment-credential-boundary.mjs"
  }
}
