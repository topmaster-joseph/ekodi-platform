{
  "schemaVersion": 1,
  "policyId": "ADMIN-AUDIENCE-001",
  "status": "active",
  "title": "Admin menu audience classification (super admin vs site admin)",
  "classifier": "ekodi-ai-orchestrator",
  "orchestrationPolicy": "AI-ORCHESTRATE-001",
  "rules": [
    "Every administrator menu entry must be classified into exactly one audience before it is built, changed or released.",
    "The classification is decided by the EKODI AI Orchestrator (classifier) and recorded in this file; development workers implement the recorded classification and never self-assign an audience.",
    "A menu without a classification, with an unknown audience, or with a classification that no longer matches a registry entry fails validation.",
    "platform-site-operations menus mirror a site-admin menu one to one; editing a specific site's data happens by entering that site's admin context under its membership, never by platform authority.",
    "Moving a menu from platform-super-admin to site-admin or platform-site-operations exposes capability to tenants and is a permission expansion that requires the sovereign human gate.",
    "Moving a menu toward platform-super-admin (narrowing exposure) is a routine reversible change the orchestrator may decide autonomously."
  ],
  "audiences": {
    "platform-super-admin": {
      "label": {
        "ko": "최고관리자 · 플랫폼 전용",
        "en": "Super Admin · Platform only"
      },
      "pathGrammar": "/admin/{group}/{menu}/{tab}",
      "visibleTo": [
        "platform_super_admin"
      ]
    },
    "platform-site-operations": {
      "label": {
        "ko": "최고관리자 · 사이트 운영 (사이트 관리자 메뉴 기준)",
        "en": "Super Admin · Site operations (mirrors site admin)"
      },
      "pathGrammar": "/admin/sites/{menu}/{tab}",
      "visibleTo": [
        "platform_super_admin"
      ],
      "mirrorsSiteAdmin": true,
      "siteMutation": "enter-site-admin-context"
    },
    "site-admin": {
      "label": {
        "ko": "사이트 관리자",
        "en": "Site admin"
      },
      "pathGrammar": "/{site}/admin/{group}/{menu}",
      "visibleTo": [
        "tenant_admin",
        "store_owner",
        "workspace_admin",
        "client_admin",
        "senior_pastor"
      ],
      "inheritsPlatformAuthority": false
    }
  },
  "audienceChangeGates": {
    "toward-tenant-exposure": "sovereign-human-gate",
    "toward-platform-only": "orchestrator-autonomous"
  },
