{
  "schemaVersion": 1,
  "policyId": "EKODI-ADAPTIVE-INFRA-001",
  "status": "enforced",
  "effectiveDate": "2026-09-28",
  "principle": "paid-core-free-first-traffic-adaptive-burn-rate-controlled-graceful-degradation",
  "scope": {
    "inheritance": "all-current-and-future-sites-services-subsurfaces",
    "localOverride": "forbidden",
    "sourceOfTruth": "supabase-postgres",
    "criticalProductionFailoverToAuxiliary": false
  },
  "signals": {
    "usagePercent": {
      "normalMaxExclusive": 60,
      "saveMaxExclusive": 75,
      "protectMaxExclusive": 90,
      "surviveMin": 90
    },
    "burnRate": {
      "minUsagePercentForEscalation": 2,
      "normalMaxExclusive": 0.7,
      "saveMaxExclusive": 1.0,
      "protectMaxExclusive": 1.5,
      "surviveMin": 1.5
    },
    "runtime": {
      "p95LatencyMs": {"save": 1500, "protect": 3000, "survive": 5000},
      "errorRatePercent": {"save": 2, "protect": 5, "survive": 10},
      "trafficSpikeRatio": {"save": 2, "protect": 4, "survive": 8}
    }
  },
  "modes": {
    "normal": {
      "cacheProfile": "balanced",
      "readPath": "cache-then-source",
      "backgroundMode": "normal",
      "auxiliaryMode": "preferred-for-noncritical"
    },
    "save": {
      "cacheProfile": "aggressive-safe",
      "readPath": "cdn-r2-snapshot-first",
      "backgroundMode": "batch-and-coalesce",
      "auxiliaryMode": "prefer-for-noncritical"
    },
    "protect": {
      "cacheProfile": "maximum-safe",
      "readPath": "snapshot-first-source-critical-only",
      "backgroundMode": "defer-low-priority",
      "auxiliaryMode": "noncritical-only"
    },
    "survive": {
      "cacheProfile": "last-known-good-safe",
      "readPath": "critical-live-safe-read-snapshots",
      "backgroundMode": "pause-nonessential",
      "auxiliaryMode": "noncritical-only"
    }
  },
  "criticality": {
    "S0": {
      "description": "must stay live and strongly consistent",
      "workloads": ["auth","identity","authorization","security","secrets","payments","finance","banking","transfers","orders","inventory-reservation"],
      "staleFallbackAllowed": false,
      "auxiliaryProductionExecutionAllowed": false
    },
    "S1": {
      "description": "core operational surfaces",
      "workloads": ["admin","my","store-admin","church-admin","business-ops","mail-admin","tenant-management"],
      "staleFallbackAllowed": "safe-read-only-only",
      "auxiliaryProductionExecutionAllowed": false
    },
    "S2": {
      "description": "read-heavy operational intelligence",
      "workloads": ["analytics","reports","statistics","search","catalog","marketing-read-models","public-content"],
      "staleFallbackAllowed": true,
      "auxiliaryProductionExecutionAllowed": "noncritical-compute-only"
    },
    "S3": {
      "description": "deferrable or experimental work",
      "workloads": ["crawler","preview-generation","experiments","development","staging","synthetic-verification","noncritical-ai","batch-analysis"],
      "staleFallbackAllowed": true,
      "auxiliaryProductionExecutionAllowed": "noncritical-compute-only"
    }
  },
  "serviceActions": {
    "normal": {"S0":"live-direct","S1":"live-cache","S2":"cache-preferred","S3":"normal-background"},
    "save": {"S0":"live-direct","S1":"cache-preferred-writes-live","S2":"snapshot-first","S3":"batch-auxiliary"},
    "protect": {"S0":"live-direct","S1":"live-aggressive-cache","S2":"snapshot-safe-read-defer-recompute","S3":"paused"},
    "survive": {"S0":"live-direct-fail-closed","S1":"essential-only","S2":"last-known-good-read-only","S3":"paused"}
  },
  "invariants": {
    "measuredTelemetryOnly": true,
    "unknownUsageNeverInvented": true,
    "securityBoundaryNeverWeakenedForCost": true,
    "S0NeverUsesStaleSnapshot": true,
    "S0NeverRunsOnAuxiliaryProductionAccount": true,
    "automaticPaidUpgrade": false,
    "automaticBillingChange": false,
    "failClosedForCriticalMutationWhenSourceUnavailable": true,
    "safeReadOnlyLastKnownGoodAllowedForNoncritical": true
  }
}
