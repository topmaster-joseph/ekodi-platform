{
  "policy": "WORKER-LANE-GRAPH-001",
  "description": "Every production Worker config names the guarded deploy workflow that converge dispatches when a merged PR changes any file in that Worker's static import graph. A workflow must accept release_branch_ref and release_task_id and pass them to its --release gate. 'excluded' records why a Worker is never auto-dispatched.",
  "workers": {
    "wrangler.ai.toml": { "workflow": "deploy-ai-control.yml" },
    "wrangler.api.toml": { "workflow": "deploy-control-api.yml" },
    "wrangler.author.toml": { "workflow": "deploy-author.yml" },
    "wrangler.bible.toml": { "workflow": "deploy-bible.yml" },
    "wrangler.biz-legacy.toml": { "workflow": "deploy-biz-legacy.yml" },
    "wrangler.books.toml": { "workflow": "deploy-books.yml" },
    "wrangler.business.toml": { "excluded": "Orphaned Worker: no code calls the BUSINESS service binding, its former public hostname is retired, and deploy-business.yml production only retires that hostname. /ekodibiz is served by Site Core and ekodibiz-revenue-os." },
    "wrangler.cgma-board-internal.toml": { "workflow": "deploy-cgma-apex-edge.yml" },
    "wrangler.cgma-naver-proof.toml": { "workflow": "deploy-cgma-naver-proof.yml" },
    "wrangler.church-history.toml": { "workflow": "deploy-church-history.yml" },
    "wrangler.church-naver-proof.toml": { "workflow": "deploy-church-naver-proof.yml", "watch_files": ["scripts/cloudflare-church-naver-redirect-exception.mjs"] },
    "wrangler.community.toml": { "workflow": "deploy-community.yml" },
    "wrangler.delivery.toml": { "workflow": "deploy-delivery-hub-ai.yml" },
    "wrangler.education.toml": { "workflow": "deploy-education.yml", "inputs": { "release_sha": "$PROTECTED_MERGE_SHA" } },
    "wrangler.ekodibiz-pay-gateway.toml": { "workflow": "deploy-ekodibiz-payment-gateway.yml" },
    "wrangler.ekodibiz.toml": { "workflow": "deploy-ekodibiz.yml" },
    "wrangler.ekodipay.toml": { "workflow": "deploy-ekodipay.yml" },
    "wrangler.energy.toml": { "workflow": "deploy-energy.yml" },
    "wrangler.experience.toml": { "workflow": "deploy-experience.yml" },
    "wrangler.finance.toml": { "excluded": "Financial API production promotion requires an explicit promote_production approval in deploy-finance.yml; it is never promoted by an automatic post-merge dispatch." },
    "wrangler.independent-board.toml": { "workflow": "deploy-independent-board.yml" },
    "wrangler.journal.toml": { "workflow": "deploy-journal.yml" },
    "wrangler.kftc-openbanking-adapter.toml": { "workflow": "deploy-money.yml" },
    "wrangler.legacy-redirect.toml": { "workflow": "deploy-legacy-redirects.yml" },
    "wrangler.life.toml": { "workflow": "deploy-life-ai.yml" },
    "wrangler.local-commerce.toml": { "workflow": "deploy-local-commerce.yml" },
    "wrangler.management.toml": { "workflow": "deploy-management.yml" },
    "wrangler.marketing-domains.toml": { "workflow": "deploy-marketing-domain-api.yml" },
    "wrangler.marketing-growth.toml": { "workflow": "deploy-marketing-growth.yml" },
    "wrangler.marketing-publishing.toml": { "workflow": "deploy-marketing-publishing.yml" },
    "wrangler.money.toml": { "workflow": "deploy-money.yml" },
    "wrangler.my.toml": { "workflow": "deploy-my.yml" },
    "wrangler.personal-finance.toml": { "excluded": "Personal finance production promotion requires an explicit promote_production approval (or a [promote-personal-finance] commit) in deploy-personal-finance.yml; never auto-promoted." },
    "wrangler.publishing.toml": { "workflow": "deploy-publishing.yml" },
    "wrangler.qtin-order.toml": { "workflow": "deploy-qtin-order.yml" },
    "wrangler.seonammedi-redirect.toml": { "workflow": "deploy-seonammedi-domains.yml" },
    "wrangler.service-admin-entry.toml": { "workflow": "deploy-service-admin-entry.yml" },
    "wrangler.service-proxy.toml": { "workflow": "deploy-service-proxy.yml" },
    "wrangler.shell.toml": { "workflow": "deploy-ekodi-shell.yml" },
    "wrangler.site.toml": { "workflow": "deploy-site-core.yml", "inputs": { "sync_domains": "false" } },
    "wrangler.social.toml": { "workflow": "deploy-social.yml" },
    "wrangler.space.toml": { "workflow": "deploy-space.yml" },
    "wrangler.storage.toml": { "workflow": "deploy-storage.yml" },
    "wrangler.support.toml": { "workflow": "deploy-support-opportunity.yml" },
    "wrangler.work.toml": { "workflow": "deploy-work.yml" },
    "wrangler.workspace-platform.toml": { "workflow": "release-messenger-investment-functional.yml" }
  }
}
