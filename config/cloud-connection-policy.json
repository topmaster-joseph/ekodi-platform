{
  "version": "1.1.0",
  "strategy": "cloud_first_provider_independent",
  "scope": {
    "includeAllEkodiSurfaces": true,
    "operaBrowserConnectorRequired": false
  },
  "priority": [
    "official_api",
    "connected_plugin",
    "oauth_cloud",
    "workload_identity",
    "cloud_browser",
    "remote_desktop",
    "opera_browser"
  ],
  "defaults": {
    "operaBrowserConnectorEnabled": false,
    "automaticFailover": true,
    "usageAwareFailover": true,
    "automaticRefreshWhenProviderAllows": true,
    "credentialStorage": "server_only_encrypted_or_managed_secret_store",
    "browserSecretsAllowed": false
  },
  "remoteDesktop": {
    "role": "local_only_secondary_adapter",
    "preferBundledOperations": true,
    "skipWhenQuotaRemainingPercentAtOrBelow": 0,
    "doNotEvadeAccountQuotaWithAnotherDevice": true
  },
  "recoverableProviderReasons": [
    "quota_exhausted",
    "rate_limited",
    "provider_error",
    "temporarily_unavailable"
  ],
  "authentication": {
    "neverBypass": [
      "login",
      "consent",
      "mfa",
      "reauthentication"
    ],
    "userActionPolicy": "request_minimum_required_action_only_when_no_authorized_alternative_exists"
  },
  "states": [
    "connected",
    "refreshable",
    "needs_user_auth",
    "unavailable"
  ]
}
