{
  "version": "1.4.0",
  "policyId": "EKODI-CONCURRENT-TRAFFIC-10K-001",
  "status": "enforced",
  "appliesRecursivelyToAllServices": true,
  "objective": {
    "normalConcurrentUsers": 100,
    "busyConcurrentUsers": 1000,
    "surgeConcurrentUsers": 10000,
    "stressTestConcurrentUsers": 50000,
    "publicDatabaseBypassTargetPercent": 95
  },
  "signals": [
    "concurrent_sessions",
    "requests_per_second",
    "p95_latency_ms",
    "error_rate_percent",
    "d1_query_latency_ms",
    "queue_backlog",
    "cache_hit_percent",
    "provider_429_1027",
    "ai_inflight"
  ],
  "runtimeGovernor": {
    "enabled": true,
    "windowSeconds": 10,
    "requestsPerSecond": {
      "L2": 30,
      "L3": 100,
      "PROTECT": 300
    },
    "rateLimiters": {
      "L2": "TRAFFIC_L2_RATE_LIMITER",
      "L3": "TRAFFIC_L3_RATE_LIMITER",
      "PROTECT": "TRAFFIC_PROTECT_RATE_LIMITER"
    },
    "adaptiveSignals": {
      "sampleWindowSeconds": 60,
      "minimumSamples": 10,
      "p95LatencyMs": {
        "L2": 1200,
        "L3": 2200,
        "PROTECT": 4000
      },
      "errorRatePercent": {
        "L2": 2,
        "L3": 5,
        "PROTECT": 12
      },
      "recoveryStableMinutes": 10,
      "stepDownOneTierAtATime": true,
      "scope": "worker_isolate_secondary_signal"
    },
    "workersCache": {
      "productionEnabled": true,
      "anonymousPublicGetOnly": true,
      "privateSurfacesExcluded": true,
      "edgeTtlSeconds": {
        "L1": 60,
        "L2": 120,
        "L3": 300,
        "PROTECT": 600
      },
      "staleWhileRevalidateSeconds": {
        "L1": 300,
        "L2": 600,
        "L3": 1800,
        "PROTECT": 3600
      },
      "staleIfErrorSeconds": 86400
    }
  },
  "tiers": [
    {
      "id": "L1",
      "maxConcurrentUsers": 100,
      "cacheProfile": "standard",
      "queueMode": "normal",
      "backgroundJobs": "normal",
      "aiMode": "normal"
    },
    {
      "id": "L2",
      "maxConcurrentUsers": 1000,
      "cacheProfile": "enhanced",
      "queueMode": "absorb-bursts",
      "backgroundJobs": "defer-low-priority",
      "aiMode": "quota-governed"
    },
    {
      "id": "L3",
      "maxConcurrentUsers": 10000,
      "cacheProfile": "aggressive-safe",
      "queueMode": "backpressure",
      "backgroundJobs": "critical-only",
      "aiMode": "strict-queue-and-quota"
    },
    {
      "id": "PROTECT",
      "maxConcurrentUsers": null,
      "cacheProfile": "maximum-safe",
      "queueMode": "shed-noncritical",
      "backgroundJobs": "paused",
      "aiMode": "essential-only"
    }
  ],
  "promotion": {
    "requiresAny": [
      "concurrency_threshold",
      "rps_pressure",
      "p95_latency_pressure",
      "queue_pressure",
      "provider_quota_pressure"
    ],
    "doNotUseConcurrencyAlone": true
  },
  "recovery": {
    "hysteresisRequired": true,
    "stableMinutes": 10,
    "stepDownOneTierAtATime": true
  },
  "dataPlane": {
    "publicReadPath": [
      "cloudflare_cache",
      "kv_or_snapshot",
      "worker_if_dynamic",
      "database_if_authoritative"
    ],
    "singleD1HotspotForbidden": true,
    "workspaceShardable": true
  },
  "media": {
    "canonicalOriginal": "google_drive",
    "databaseStoresBytes": false,
    "databaseStores": [
      "provider_file_id",
      "drive_id",
      "mime_type",
      "bytes",
      "checksum",
      "visibility",
      "delivery_url",
      "thumbnail_url",
      "service_id",
      "workspace_id"
    ],
    "publicDelivery": [
      "cloudflare_cache",
      "r2_when_hot_or_public",
      "youtube_or_streaming_provider_for_large_video"
    ],
    "driveHotPathApiCallsForbidden": true
  },
  "failurePolicy": {
    "quotaStatuses": [
      429,
      1027
    ],
    "circuitBreaker": true,
    "failClosedForProtectedData": true,
    "preserve": [
      "public_read",
      "auth",
      "forms",
      "orders",
      "payments",
      "admin_control"
    ],
    "shedFirst": [
      "crawler",
      "analytics_detail",
      "background_ai",
      "noncritical_probes"
    ]
  },
  "writePlane": {
    "policy": "EKODI-DURABLE-WRITE-INGRESS-001",
    "publicBurstEligibleWrites": "queue-first",
    "productionDirectDatabaseWrite": "forbidden",
    "successRequiresDurableAcceptance": true,
    "idempotencyRequired": true,
    "deadLetterRequired": true,
    "queueBinding": "EKODI_WRITE_QUEUE"
  },
  "edgeSecurity": {
    "rateLimiters": {
      "publicWrite": "PLATFORM_PUBLIC_WRITE_RATE_LIMITER",
      "sensitive": "PLATFORM_SENSITIVE_RATE_LIMITER",
      "auth": "AUTH_RATE_LIMITER"
    },
    "blockedMethods": [
      "TRACE",
      "CONNECT"
    ],
    "requestBodyLimitsRequired": true,
    "botAndWafAtCloudflareEdge": "preferred",
    "turnstileForAnonymousPublicWrites": "preferred_when_enabled_or_abuse_detected",
    "protectedDataFailsClosed": true,
    "publicReadAssetFirst": true
  },
  "storage": {
    "canonicalFileStore": "google_drive",
    "r2Role": [
      "cache",
      "public_delivery",
      "temporary_staging",
      "web_mirror"
    ],
    "r2SystemOfRecord": false,
    "driveHotPathApiCallsForbidden": true,
    "serveHotPublicMediaFromEdgeOrR2": true
  },
  "quotaProtection": {
    "warningPercent": 70,
    "conservePercent": 85,
    "protectPercent": 90,
    "survivalPercent": 95,
    "circuitBreakerPercent": 100,
    "stopRetryStatuses": [
      429,
      1027
    ],
    "shedBeforeCore": [
      "crawler",
      "analytics_detail",
      "background_ai",
      "noncritical_probes"
    ],
    "preserveCore": [
      "public_read",
      "auth",
      "forms",
      "orders",
      "payments",
      "admin_control"
    ]
  },
  "edgeTrafficShield": {
    "policyId": "EKODI-EDGE-TRAFFIC-SHIELD-001",
    "module": "edge-traffic-shield.js",
    "clientIsolation": {
      "enabled": true,
      "runsBeforeSiteWideTier": true,
      "readsFailOpen": true,
      "rateLimiters": {
        "client": "TRAFFIC_CLIENT_RATE_LIMITER",
        "network": "TRAFFIC_NETWORK_RATE_LIMITER"
      },
      "clientRequestsPer10s": 600,
      "networkRequestsPer10s": 2000,
      "identity": "bearer or cookie digest, else IP+UA digest; IP-only ceiling; no cf-connecting-ip (service binding) is not bucketed",
      "sizing": "client 600/10s stays below the L3 site-wide trigger (1000/10s) so one client cannot shed crawlers for everyone; network 2000/10s stays below PROTECT (3000/10s) and leaves room for a classroom behind one campus NAT"
    },
    "satelliteCoverage": {
      "required": true,
      "reason": "apex path routes matched before the Shared Site route never pass its guard",
      "workers": {
        "church-history-worker.js": "wrangler.church-history.toml",
        "delivery-worker.js": "wrangler.delivery.toml",
        "ekodibiz-pay-gateway-worker.js": "wrangler.ekodibiz-pay-gateway.toml",
        "ekodipay-worker.js": "wrangler.ekodipay.toml",
        "local-commerce-worker.js": "wrangler.local-commerce.toml",
        "ministry-news-worker.js": "wrangler.ministry-news.toml",
        "qtin-order-entry.js": "wrangler.qtin-order.toml",
        "support-worker.js": "wrangler.support.toml",
        "seonammedi-domain-gateway.js": "wrangler.seonammedi-redirect.toml",
        "services/independent-board/worker.js": "wrangler.independent-board.toml"
      },
      "writeLimiterWithoutBindings": "method/query/body checks only (never 503 a payment callback)"
    },
    "selfGeneratedTraffic": {
      "deviceAgentIdlePollSeconds": {
        "min": 10,
        "max": 20,
        "afterCommand": 2,
        "interactiveAuth": 5
      },
      "evidence": "2026-11-17 zone analytics: device-agent commands/next+heartbeat = 16,212 of 39,469 ekodi.kr requests (41%)"
    },
    "zoneEdge": {
      "script": "scripts/cloudflare-zone-traffic-shield.mjs",
      "defaultMode": "plan",
      "ipRequestsPer10s": 3000,
      "mitigationSeconds": 10,
      "note": "Free plan: one rule, IP characteristic, 10s period, 10s block; counts cached assets too, so the threshold is a pure flood ceiling"
    }
  }
}
