{
  "schemaVersion": 1,
  "policyId": "CF-QUOTA-001",
  "purpose": "Protect EKODI Production with plan-aware Cloudflare quota control: Free-safe before owner upgrade, Paid-core after verified Workers Paid activation, while keeping nonessential usage inside included capacity.",
  "dailyRequestLimit": 100000,
  "warningRatio": 0.7,
  "protectRatio": 0.9,
  "productionAccountEnv": "CLOUDFLARE_ACCOUNT_ID",
  "developmentAccountEnv": "CLOUDFLARE_DEVELOPMENT_ACCOUNT_ID",
  "knownDevelopmentAccountIds": [
    "46aad4738793fbaca88574832a2ccc0f"
  ],
  "circuitBreaker": {
    "statuses": [
      429
    ],
    "bodyMarkers": [
      "Error 1027",
      "temporarily rate limited",
      "reached their plan limits"
    ]
  },
  "canary": {
    "essential": [
      {
        "id": "admin",
        "url": "https://ekodi.kr/admin/",
        "status": 200,
        "text": "<title>EKODI Admin</title>",
        "header": {
          "name": "x-ekodi-route",
          "contains": "admin-shell"
        }
      },
      {
        "id": "control-api",
        "url": "https://ekodi.kr/health",
        "status": 200
      }
    ],
    "nonessential": [
      {
        "id": "root",
        "url": "https://ekodi.kr/",
        "status": 200
      },
      {
        "id": "cgma",
        "url": "https://ekodi.kr/cgma/",
        "status": 200,
        "text": "청계면상인회"
      },
      {
        "id": "jadam",
        "url": "https://ekodi.kr/jadam",
        "status": 200,
        "text": "자담치킨 목포대점"
      },
      {
        "id": "pizzamaru",
        "url": "https://ekodi.kr/pizzamaru",
        "status": 200,
        "text": "피자마루 목포대점"
      },
      {
        "id": "yogurt",
        "url": "https://ekodi.kr/yogurt",
        "status": 200,
        "text": "요거트퍼플 목포대점"
      },
      {
        "id": "marketing",
        "url": "https://ekodi.kr/ekodibiz/marketing-ai",
        "status": 200,
        "text": "마케팅AI"
      }
    ]
  },
  "planDetection": {
    "mode": "billing-api-when-readable",
    "fallback": "free-safe",
    "ownerActivationRequired": true,
    "automaticPurchase": false
  },
  "paidPlan": {
    "minimumMonthlyUsd": 5,
    "workersRequestsIncludedPerMonth": 10000000,
    "d1RowsReadIncludedPerMonth": 25000000000,
    "d1RowsWrittenIncludedPerMonth": 50000000,
    "d1StorageIncludedBytes": 5368709120,
    "overagePolicy": "protect-nonessential-before-included-capacity-is-exhausted"
  },
  "freePlan": {
    "workersRequestsPerDay": 100000,
    "d1RowsReadPerDay": 5000000,
    "d1RowsWrittenPerDay": 100000,
    "d1StorageBytes": 5368709120
  }
}
