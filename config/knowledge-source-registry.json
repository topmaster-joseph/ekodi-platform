{
  "schemaVersion": 1,
  "registryId": "ekodi.knowledge-source.v1",
  "status": "enforced",
  "effectiveDate": "2026-09-19",
  "principle": "Knowledge is provenance-first, version-aware and freshness-aware. Dynamic claims prefer current primary sources over remembered or derived text.",
  "requiredSourceFields": [
    "sourceId",
    "domain",
    "sourceType",
    "authority",
    "owner",
    "versionPolicy",
    "effectiveDatePolicy",
    "verificationPolicy",
    "lifecycleState"
  ],
  "sourceTypes": [
    "ekodi_canonical",
    "workspace_private",
    "official_primary",
    "authoritative_reference",
    "secondary_reference",
    "user_supplied",
    "model_generated"
  ],
  "trustOrder": [
    "ekodi_canonical",
    "workspace_private",
    "official_primary",
    "authoritative_reference",
    "user_supplied",
    "secondary_reference",
    "model_generated"
  ],
  "dynamicKnowledgePolicy": {
    "reverifyBeforeMaterialDecision": true,
    "currentPrimarySourcePreferred": true,
    "unverifiableState": "needs_verification",
    "staleSourceMayNotSilentlyOverrideCurrentSource": true
  },
  "baselineSources": [
    {
      "sourceId": "ekodi.constitution",
      "domain": "governance",
      "sourceType": "ekodi_canonical",
      "authority": "EKODI Platform Super Administrator",
      "owner": "topmaster-joseph",
      "versionPolicy": "constitution_version",
      "effectiveDatePolicy": "approved_amendment_date",
      "verificationPolicy": "repository_and_governance_gate",
      "lifecycleState": "active"
    },
    {
      "sourceId": "ekodi.repository",
      "domain": "platform",
      "sourceType": "ekodi_canonical",
      "authority": "Git repository main branch after guarded merge",
      "owner": "topmaster-joseph",
      "versionPolicy": "git_commit_sha",
      "effectiveDatePolicy": "git_commit_time",
      "verificationPolicy": "ci_and_guarded_release",
      "lifecycleState": "active"
    }
  ],
  "acquisitionPolicy": {
    "mode": "on_demand_plus_change_detection",
    "bulkCrawlingByDefault": false,
    "order": [
      "official_connector_or_api",
      "webhook",
      "rss_atom",
      "sitemap_incremental_fetch",
      "bounded_html_fetch",
      "manual_reviewed_source"
    ],
    "htmlFetchRequires": [
      "robots_verified",
      "terms_verified",
      "rights_verified"
    ],
    "changedOnly": true,
    "adaptiveSchedule": true,
    "externalInstructions": "untrusted_reference_data_only"
  },
  "learningPromotionPolicy": {
    "stages": [
      "observation",
      "verified_candidate",
      "service_memory_candidate",
      "platform_review_required",
      "platform_knowledge_promoted"
    ],
    "rawUserContentLearningByDefault": false,
    "platformMinimumScore": 90,
    "repeatedVerifiedOutcomes": 3,
    "humanApprovalRequiredForPlatform": true,
    "authorityExpansionAllowed": false,
    "productionMutationAllowed": false
  }
}
