{
  "version": 1,
  "effectiveDate": "2026-09-10",
  "principle": "Externally provided EKODI services and sites are operated through their own service/site administrator surfaces; Platform Super Administrator directly owns only EKODI Core, internal control/common services, constitutional governance, cross-service security and platform-wide guardrails.",
  "platformSuperAdministrator": {
    "directOwnership": [
      "ekodi-core",
      "identity-and-auth-control",
      "platform-routing-and-domain-governance",
      "platform-security-and-privacy-guardrails",
      "cross-service-observability",
      "constitutional-governance",
      "internal-control-services"
    ],
    "serviceLocalAuthorityMode": "explicit-observe-or-intervene-only",
    "implicitTenantAdminAuthority": false
  },
  "externalServiceAdministration": {
    "defaultOwner": "service-or-site-administrator",
    "workspaceDelegation": true,
    "roleAndMembershipScoped": true,
    "crossWorkspacePrivateDataSharing": false
  },
  "readingDialogue": {
    "provider": "community",
    "publicProviderName": "EKODI Community",
    "publicServiceName": "함께읽기",
    "canonicalPath": "/community/reading",
    "adminOwner": "community-admin",
    "internalCapability": "EKODI Reading & Dialogue Engine",
    "bookCatalogDependency": "books-public-contract",
    "workspaceConsumers": ["church", "association", "business", "school", "nonprofit", "institution", "project", "personal"],
    "newSubdomain": false
  }
}
