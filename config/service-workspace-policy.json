{
  "schemaVersion": 5,
  "provider": {
    "legalOperator": "EKODIBIZ",
    "role": "service_provider"
  },
  "entityBoundary": {
    "service": "EKODI가 제공·운영하는 공통 기능 또는 상품",
    "workspace": "EKODI 서비스를 이용하는 개인·사업체·교회·기관·단체·프로젝트의 독립 운영공간",
    "entitlement": "사용자 또는 Workspace가 특정 Service를 이용할 수 있는 권리"
  },
  "userServiceKinds": [
    {
      "id": "shared_user_service",
      "label": "사용자 공용서비스"
    },
    {
      "id": "dedicated_user_service",
      "label": "사용자 전용서비스"
    }
  ],
  "visibilityPolicies": [
    {
      "id": "guest_visible",
      "label": "비회원 노출 ON",
      "guestVisible": true,
      "existingMemberAccess": true
    },
    {
      "id": "guest_hidden",
      "label": "비회원 노출 OFF",
      "guestVisible": false,
      "existingMemberAccess": true
    },
    {
      "id": "member_forced_off",
      "label": "회원 이용 강제 OFF",
      "guestVisible": false,
      "existingMemberAccess": false
    }
  ],
  "customerWorkspaceRule": {
    "mustNotAppearInProviderServiceRegistry": true,
    "managedBy": "customer_tenant_directory",
    "preserveCustomerOwnership": true,
    "examples": [
      "청계면상인회",
      "자담치킨 목포대점",
      "피자마루 목포대점",
      "요거트퍼플 목포대점"
    ]
  },
  "publicWorkspaceRouting": {
    "canonicalHost": "ekodi.kr",
    "workspaceIdentityKey": "workspace_id",
    "slugRole": "routing_locator_only",
    "workspaceSubdomains": "forbidden",
    "legacyRedirects": {
      "space.ekodi.kr/{slug}": "ekodi.kr/{slug}",
      "user.ekodi.kr/{slug}": "ekodi.kr/{slug}"
    },
    "canonicalPattern": "/{slug}",
    "servicePattern": "/{slug}/{service}",
    "adminPattern": null,
    "serviceAdminPattern": null,
    "kindEncodedInUrl": false,
    "reservedRootSlugsManagedBy": "platform_route_registry",
    "adminSurface": "/admin/workspaces",
    "legacyAdminPatterns": [
      "/{slug}/admin",
      "/{slug}/{service}/admin"
    ]
  },
  "serviceImplementationSelection": {
    "workspaceMaySelectCompatibleImplementation": true,
    "ekodiDefaultImplementationMayExist": true,
    "externalImplementationRequiresStandardContract": true,
    "externalImplementationDirectPrivateDatabaseAccess": false,
    "disconnectPreservesWorkspaceIdentity": true,
    "selectionAuthorities": [
      "user",
      "workspace-admin",
      "ekodi-orchestrator-policy"
    ],
    "selectionFactors": [
      "user-choice",
      "workspace-policy",
      "quality",
      "cost",
      "latency",
      "availability",
      "privacy",
      "provider-independence"
    ]
  },
  "subdomainExceptions": {
    "personalHome": null,
    "administration": null,
    "authentication": null,
    "api": null,
    "status": "status.ekodi.kr",
    "commonAndCoreServices": "allowed_only_when_security_operational_protocol_or_service_boundary_is_justified_and_registered"
  },
  "commonServiceUserAccessRule": {
    "appliesTo": [
      "platform-core",
      "shared-service"
    ],
    "surface": "user-pages",
    "guestExperience": "service-guide-only",
    "memberMinimumTier": "free",
    "loginProvider": "google",
    "excludeCustomerSites": true
  },
  "identityAuthority": "ekodi",
  "linkedIdentityProviders": [
    "google"
  ],
  "userSurfaceTopologyPolicy": {
    "customerSpecificAiSubdomains": "forbidden_as_canonical",
    "marketingProduct": "https://ekodi.kr/ekodibiz/marketing-ai",
    "workspaceMarketingPattern": "https://ekodi.kr/{slug}/marketing",
    "marketingCore": "https://marketing.ekodi.kr",
    "aiGateway": "https://ai.ekodi.kr",
    "providerTopologyVisibleToOrdinaryUsers": false,
    "examples": {
      "jadamMarketing": "https://ekodi.kr/jadam/marketing",
      "pizzamaruMarketing": "https://ekodi.kr/pizzamaru/marketing",
      "yogurtMarketing": "https://ekodi.kr/yogurt/marketing",
      "cgmaMarketing": "https://ekodi.kr/cgma/marketing"
    }
  },
  "serviceAdministrationPolicy": {
    "principle": "핵심코어와 내부 운영서비스는 플랫폼 최고관리자가 중앙에서 직접 관리하고, 외부 사용자에게 제공되는 서비스와 사이트의 실제 운영은 해당 서비스·사이트 관리자 페이지를 운영 원장으로 삼는다.",
    "platformSuperAdministrator": {
      "directScope": [
        "ekodi-core",
        "identity-and-auth-control",
        "internal-control-services",
        "constitutional-governance",
        "platform-routing-and-domain-governance",
        "cross-service-security-and-privacy",
        "cross-service-observability-and-guardrails"
      ],
      "externalServiceMode": "directory-observe-audit-and-explicit-intervention",
      "implicitServiceLocalRole": false,
      "implicitWorkspaceLocalRole": false
    },
    "externalServiceAndSite": {
      "operationalSourceOfTruth": "service-or-site-admin-surface",
      "defaultOperationalOwner": "service-or-site-administrator",
      "centralAdminRole": "directory-observability-governance-and-explicit-intervention",
      "workspaceAdministration": "membership-role-capability-scoped",
      "crossWorkspacePrivateDataSharing": false
    }
  },
  "publicServiceOperators": {
    "readingDialogue": {
      "providerKey": "community",
      "providerName": "EKODI Community",
      "publicServiceName": "함께읽기",
      "canonicalPath": "https://ekodi.kr/community/reading",
      "operationalAdminOwner": "community-service-admin",
      "internalCapability": "EKODI Reading & Dialogue Engine",
      "bookCatalogDependency": "books-public-contract",
      "groupAndParticipationOwner": "community",
      "workspaceLocalAdministration": true,
      "newSubdomain": false
    }
  },
  "commonServiceOperatorAccessRule": {
    "surface": "https://ekodi.kr/admin",
    "canonicalPath": "/admin/services/common-services",
    "runtimeHostsAreOperatorPages": false,
    "directRuntimeRootBehavior": "redirect_to_admin_control_plane",
    "sessionAuthority": "central_admin_session",
    "authorityContext": "Person + Workspace + Role + Capability",
    "internalOperationalInfoBeforeAuthentication": false,
    "perServiceLoginUi": false,
    "runtimeApiMayRemainOnDedicatedHost": true,
    "capabilityExamples": [
      "service:read",
      "service:operate",
      "ai:read",
      "ai:operate"
    ]
  },
  "canonicalSurfaces": {
    "public": "/",
    "user": "/my",
    "admin": "/admin",
    "auth": "/auth",
    "api": "/api",
    "mcp": "/mcp",
    "webhooks": "/webhooks",
    "health": "/health"
  },
  "managementRouting": {
    "home": "/admin/home/{capability}",
    "operations": "/admin/operations/{capability}",
    "workspaces": "/admin/workspaces/{capability}",
    "services": "/admin/services/{service}",
    "system": "/admin/system/{capability}"
  }
}
