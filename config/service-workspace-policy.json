{
  "schemaVersion": 4,
  "provider": {
    "legalOperator": "EKODIBIZ",
    "role": "service_provider"
  },
  "entityBoundary": {
    "service": "EKODI가 제공·운영하는 공통 기능 또는 상품",
    "workspace": "EKODI 서비스를 이용하는 개인·사업체·교회·기관·단체·프로젝트의 독립 운영공간",
    "entitlement": "사용자 또는 Workspace가 특정 Service를 이용할 수 있는 권리"
  },
  "userServiceKinds": [
    {"id": "shared_user_service", "label": "사용자 공용서비스"},
    {"id": "dedicated_user_service", "label": "사용자 전용서비스"}
  ],
  "visibilityPolicies": [
    {"id": "guest_visible", "label": "비회원 노출 ON", "guestVisible": true, "existingMemberAccess": true},
    {"id": "guest_hidden", "label": "비회원 노출 OFF", "guestVisible": false, "existingMemberAccess": true},
    {"id": "member_forced_off", "label": "회원 이용 강제 OFF", "guestVisible": false, "existingMemberAccess": false}
  ],
  "customerWorkspaceRule": {
    "mustNotAppearInProviderServiceRegistry": true,
    "managedBy": "customer_tenant_directory",
    "preserveCustomerOwnership": true,
    "examples": ["청계면상인회", "자담치킨 목포대점", "피자마루 목포대점", "요거트퍼플 목포대점"]
  },
  "publicWorkspaceRouting": {
    "canonicalHost": "ekodi.kr",
    "workspaceIdentityKey": "workspace_id",
    "publicNamespaceKey": "public_namespace",
    "canonicalPattern": "/{public_namespace}",
    "servicePattern": "/{public_namespace}/{service}",
    "workspaceTypeInUrl": false,
    "workspaceDisplayNameUnique": false,
    "publicNamespaceUnique": true,
    "namespaceRole": "routing_locator_only",
    "namespaceConflictPolicy": "first_valid_claim_wins_then_suggest_alternatives",
    "namespaceAssignmentAuthority": "ekodi_core",
    "organizationSubtypes": ["business", "church", "school", "nonprofit", "association", "institution"],
    "workspaceSubdomains": "forbidden",
    "reservedNamespaceExamples": ["admin", "api", "auth", "my", "status", "mall", "shop", "pay", "marketing", "books", "community", "work", "trade", "live"],
    "legacyRedirects": {
      "/personal/{slug}": "/{public_namespace}",
      "/org/{slug}": "/{public_namespace}",
      "/group/{slug}": "/{public_namespace}",
      "/project/{slug}": "/{public_namespace}",
      "/people/{slug}": "/{public_namespace}",
      "/biz/{slug}": "/{public_namespace}",
      "space.ekodi.kr": "ekodi.kr",
      "user.ekodi.kr": "ekodi.kr"
    }
  },
  "userSurfaceTopologyPolicy": {
    "rule": "User-facing URLs express the user/workspace/business and the service being used; AI provider, model, orchestration and engine topology are implementation details.",
    "businessServicePattern": "https://ekodi.kr/{business_namespace}/{service}",
    "workspaceServicePattern": "https://ekodi.kr/{public_namespace}/{service}",
    "workspaceAdminPattern": "https://ekodi.kr/{public_namespace}/admin",
    "customerSpecificAiSubdomains": "forbidden_as_canonical",
    "providerOrModelNameInCustomerCanonical": "forbidden",
    "professionalEngineSubdomain": "allowed_only_as_registered_non_customer_boundary",
    "ordinaryUserProviderDisclosure": "hidden_unless_consent_safety_legal_or_explicit_technical_context_requires_it",
    "examples": {
      "ekodibizMarketingProduct": "https://ekodi.kr/ekodibiz/marketing-ai",
      "jadamMarketing": "https://ekodi.kr/jadam/marketing",
      "marketingEngine": "https://marketing.ekodi.kr",
      "aiGateway": "https://ai.ekodi.kr"
    }
  },
  "subdomainExceptions": {
    "personalHome": "my.ekodi.kr",
    "administration": "admin.ekodi.kr",
    "authentication": "auth.ekodi.kr",
    "api": "api.ekodi.kr",
    "status": "status.ekodi.kr",
    "commonAndCoreServices": "allowed_only_when_security_operational_protocol_or_service_boundary_is_justified_and_registered"
  },
  "commonServiceUserAccessRule": {
    "appliesTo": ["platform-core", "shared-service"],
    "surface": "user-pages",
    "guestExperience": "service-guide-only",
    "memberMinimumTier": "free",
    "loginProvider": "google",
    "excludeCustomerSites": true
  },
  "identityAuthority": "ekodi",
  "linkedIdentityProviders": ["google"]
}
