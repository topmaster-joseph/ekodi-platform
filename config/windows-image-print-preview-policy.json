{
  "id": "EKODI-WINDOWS-IMAGE-PRINT-PREVIEW-001",
  "version": 1,
  "status": "enforced",
  "scope": [
    "managed-windows-pc"
  ],
  "intent": "Image right-click Print must open the Windows photo print preview/layout flow before final submission to a printer.",
  "desiredState": {
    "association": "SystemFileAssociations\\image\\shell\\print",
    "previewDropTargetClsid": "{60fd46de-f830-4894-a628-6fa81bc0190d}",
    "perUserDirectPrintCommandOverrideAllowed": false,
    "previewBeforeFinalPrint": true
  },
  "execution": {
    "statusCommand": "printing.image_preview.status",
    "repairCommand": "printing.image_preview.repair",
    "restoreCommand": "printing.image_preview.restore",
    "preferredExecutor": "ekodi-device-agent",
    "remoteToolQuotaFallback": "ekodi-device-agent",
    "autoReconcileEnabledAfterRepair": true,
    "reconcileCadenceSeconds": 10,
    "foregroundWindowControl": false,
    "arbitraryShell": false
  },
  "safety": {
    "userHiveOnly": true,
    "machineWideRegistryMutationForbidden": true,
    "backupBeforeFirstMutation": true,
    "reversible": true,
    "userOwnedWindowMutationForbidden": true
  },
  "verification": {
    "effectiveDropTargetReadbackRequired": true,
    "userCommandOverrideAbsentRequired": true,
    "runtimeCommandResultRequired": true,
    "finalHumanBehaviorCheck": "right-click image -> Print -> preview/layout -> final Print"
  }
}
