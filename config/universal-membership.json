{
  "schemaVersion": 2,
  "policyId": "public-by-default-progressive-membership",
  "identity": {
    "primaryLogin": "google",
    "singleEcosystemAccount": true,
    "repeatSignupPerService": false
  },
  "defaultEntitlement": {
    "scope": "all_registry_user_services",
    "tier": "free",
    "materialization": "lazy_on_first_service_use",
    "portfolioProjection": "synthesized_until_materialized"
  },
  "paidPlans": {
    "scope": "service_specific",
    "sharedPaidTierAcrossAllServices": false,
    "upgradeIndependently": true,
    "downgradeIndependently": true,
    "billingLedger": "service_subscriptions",
    "configurationAuthority": "site_admin",
    "benefitUnit": [
      "feature",
      "addon",
      "package",
      "service",
      "organization_plan"
    ],
    "siteAdminMayEdit": true
  },
  "myEkodi": {
    "showAllRegistryServices": true,
    "showEffectiveTier": true,
    "handoffToOwningService": true,
    "doNotOwnSpecialistPrivateData": true
  },
  "automaticInheritance": {
    "sourceRegistry": "config/ecosystem-services.json",
    "generator": "scripts/generate-user-service-registry.mjs",
    "generatedServerModule": "generated/user-services.js",
    "generatedMyModule": "my/user-services.js",
    "enabledForFutureRegistryServices": true
  },
  "excludedInfrastructure": [
    "admin",
    "api",
    "auth",
    "control",
    "core",
    "finance",
    "security",
    "shell",
    "workspace-api"
  ],
  "guestAccess": {
    "scope": "all_user_facing_sites",
    "mode": "full_public_site",
    "minimumTierForContent": null,
    "identityProvider": null,
    "exceptions": [
      "administrator_surface",
      "private_personal_data",
      "private_workspace_data",
      "security_sensitive_action"
    ]
  },
  "freeMemberBenefits": {
    "purpose": "additional_basic_benefits_not_access",
    "siteAdminConfigurable": true,
    "platformDefaults": [
      "favorites_and_saved",
      "personalized_updates",
      "participation_history"
    ],
    "mayRequireLoginForPersonalState": true
  },
  "siteBenefitAdministration": {
    "surface": "workspace_admin",
    "canonicalSection": "membership",
    "scope": "workspace_or_workspace_service",
    "publicAccessImmutable": true,
    "auditRequired": true,
    "centralPlatformDefinesGuardrailsOnly": true
  }
}
