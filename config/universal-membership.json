{
  "schemaVersion": 1,
  "policyId": "one-account-free-everywhere-pay-where-needed",
  "identity": {
    "primaryLogin": "google",
    "singleEcosystemAccount": true,
    "repeatSignupPerService": false
  },
  "defaultEntitlement": {
    "scope": "all_registry_user_services",
    "tier": "free",
    "materialization": "lazy_on_first_service_use",
    "portfolioProjection": "synthesized_until_materialized"
  },
  "paidPlans": {
    "scope": "service_specific",
    "sharedPaidTierAcrossAllServices": false,
    "upgradeIndependently": true,
    "downgradeIndependently": true,
    "billingLedger": "service_subscriptions"
  },
  "myEkodi": {
    "showAllRegistryServices": true,
    "showEffectiveTier": true,
    "handoffToOwningService": true,
    "doNotOwnSpecialistPrivateData": true
  },
  "automaticInheritance": {
    "sourceRegistry": "config/ecosystem-services.json",
    "generator": "scripts/generate-user-service-registry.mjs",
    "generatedServerModule": "generated/user-services.js",
    "generatedMyModule": "my/user-services.js",
    "enabledForFutureRegistryServices": true,
    "siteMemberHomePolicy": "config/site-member-home.json",
    "siteMemberHomeGenerator": "scripts/generate-site-member-home-foundation.mjs",
    "futureRegistryServicesAppearWithoutPerUserMigration": true
  },
  "excludedInfrastructure": [
    "admin",
    "api",
    "auth",
    "control",
    "core",
    "finance",
    "security",
    "shell",
    "workspace-api"
  ],
  "guestAccess": {
    "scope": "common_service_user_pages",
    "mode": "public_content",
    "minimumTierForContent": "guest",
    "identityProvider": "google",
    "memberTierForPersonalization": "free",
    "publicExceptions": [
      "auth_handoff",
      "legal_notice",
      "health_check",
      "required_webhook"
    ]
  },
  "siteMemberHome": {
    "defaultAfterSiteLogin": true,
    "globalMyEkodiFallback": "https://ekodi.kr/my/",
    "canonicalWorkspacePattern": "https://ekodi.kr/{slug}/my",
    "canonicalServicePattern": "https://ekodi.kr/{canonical-service-path}/my",
    "foundationMaterialization": "eager_on_person_tenant_store_creation",
    "serviceAndCapabilityProjection": "live_from_current_registries",
    "customizationStorage": "site_member_home_preferences",
    "customizationGrantsAuthorization": false
  }
}
