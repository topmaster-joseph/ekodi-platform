{
  "schemaVersion": 1,
  "policyId": "EKODI-BOARD-NATIVE-VERIFY-001",
  "status": "enforced",
  "owner": "ekodi-orchestrator",
  "canonicalOrigin": "https://ekodi.kr",
  "maxPaths": 12,
  "readOnly": true,
  "devices": [
    "desktop",
    "mobile-portrait"
  ],
  "surfaces": [
    {
      "id": "seonammedi.citizen_voice",
      "path": "/seonammedi/#voices",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "seonammedi.notice",
      "path": "/seonammedi/#notices",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "community",
      "path": "/community/",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "journal.posts",
      "path": "/journal",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "ekodimission.activity_archive",
      "path": "/ekodimission/activities/261003-autumn-community-trip/archive",
      "enabled": true,
      "kind": "activity-results"
    }
  ],
  "expansionRule": "register-active-board-surface-without-editing-browser-workflow"
}
