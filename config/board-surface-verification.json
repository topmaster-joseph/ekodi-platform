    },
    {
      "id": "cheonggye.board",
      "path": "/cheonggye/board",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "cgma.board",
      "path": "/cgma/board",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "community.board",
      "path": "/community/board",
      "enabled": false,
