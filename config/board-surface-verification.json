      "path": "/seonammedi/board/notices",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "community",
      "path": "/community/",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "journal.posts",
      "path": "/journal",
      "enabled": true,
      "kind": "board"
    },
    {
      "id": "ekodimission.activity_archive",
