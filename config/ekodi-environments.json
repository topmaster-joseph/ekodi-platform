{
  "version": "1.1",
  "canonicalRepository": "topmaster-joseph/ekodi-platform",
  "principles": {
    "oneCanonicalRepository": true,
    "sharedDatabaseByDefault": true,
    "dedicatedDatabaseWhenJustified": true,
    "productionDataNeverCopiedRawToNonProduction": true,
    "identityEnvironmentIsolation": true
  },
  "environments": {
    "production": {
      "git": {
        "branch": "main",
        "githubEnvironment": "production"
      },
      "cloudflare": {
        "environment": "production"
      },
      "supabase": {
        "logicalName": "ekodi-platform",
        "currentProjectRef": "renzehysxirjilvdxacv",
        "currentProjectName": "ekodi-platform",
        "state": "canonical-platform-active"
      },
      "identity": {
        "canonicalOrigin": "https://ekodi.kr",
        "authPath": "/auth",
        "profile": "production"
      }
    },
    "development": {
      "git": {
        "branch": "development",
        "githubEnvironment": "development"
      },
      "cloudflare": {
        "environment": "development-staging"
      },
      "supabase": {
        "logicalName": "ekodi-platform-dev",
        "currentProjectRef": "lxcxwbdwwojjkgybbqii",
        "currentProjectName": "ekodi-church",
        "state": "transition-until-church-data-is-safely-migrated"
      },
      "identity": {
        "canonicalOrigin": "http://127.0.0.1:4173",
        "authPath": "/auth",
        "profile": "development"
      }
    },
    "staging": {
      "git": {
        "branch": "pull-request",
        "githubEnvironment": "staging"
      },
      "cloudflare": {
        "environment": "staging",
        "accountBoundary": "development-staging-account",
        "credentialProfile": "staging-only"
      },
      "identity": {
        "canonicalOrigin": "https://staging.ekodi.kr",
        "authPath": "/auth",
        "profile": "staging",
        "sessionStore": "ekodi-auth-staging"
      },
      "data": {
        "productionDataAllowed": false,
        "syntheticOrAnonymizedOnly": true
      }
    }
  },
  "postgres": {
    "isolationLayers": [
      "schema",
      "tenant_id",
      "row_level_security",
      "cloudflare_api_boundary"
    ],
    "targetSchemas": [
      "core",
      "identity",
      "tenancy",
      "shared",
      "church",
      "church_private",
      "market",
      "commerce",
      "community",
      "work",
      "content",
      "ai",
      "audit",
      "private",
      "api"
    ]
  },
  "liveness": {
    "supabase": {
      "enabled": true,
      "method": "read-only-rpc",
      "rpc": "public.ekodi_keepalive",
      "cadence": "three-times-daily",
      "writesAllowed": false
    },
    "cloudflare": {
      "syntheticKeepalive": false
    }
  }
}
