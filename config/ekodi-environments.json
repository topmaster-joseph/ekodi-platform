{
  "version": "1.1",
  "canonicalRepository": "topmaster-joseph/ekodi-platform",
  "principles": {
    "oneCanonicalRepository": true,
    "sharedDatabaseByDefault": true,
    "dedicatedDatabaseWhenJustified": true,
    "productionDataNeverCopiedRawToNonProduction": true,
    "environmentIsolationIsNotTrafficSharding": true
  },
  "environments": {
    "production": {
      "git": {
        "branch": "main",
        "githubEnvironment": "production"
      },
      "cloudflare": {
        "environment": "production"
      },
      "supabase": {
        "logicalName": "ekodi-prod",
        "currentProjectRef": "renzehysxirjilvdxacv",
        "currentProjectName": "ekodi-platform-prod",
        "state": "canonical-platform-active",
        "realUserDataAllowed": true
      }
    },
    "development": {
      "git": {
        "branch": "development",
        "githubEnvironment": "development",
        "pullRequestStagingUsesEnvironment": "development"
      },
      "cloudflare": {
        "environment": "development-staging"
      },
      "supabase": {
        "logicalName": "ekodi-dev",
        "currentProjectRef": "lxcxwbdwwojjkgybbqii",
        "currentProjectName": "ekodi-platform-dev",
        "state": "development-active-with-legacy-drain",
        "validationMode": "remote-dev-plus-ephemeral-local-ci",
        "realUserDataAllowed": false,
        "productionCredentialAccessAllowed": false
      }
    }
  },
  "postgres": {
    "isolationLayers": [
      "schema",
      "tenant_id",
      "row_level_security",
      "cloudflare_api_boundary"
    ],
    "targetSchemas": [
      "core",
      "identity",
      "tenancy",
      "shared",
      "church",
      "church_private",
      "market",
      "commerce",
      "community",
      "work",
      "content",
      "ai",
      "audit",
      "private",
      "api"
    ]
  },
  "promotion": {
    "path": "short-lived-branch -> pull-request -> development -> guarded-main -> production -> live-verification",
    "versionedMigrationsRequired": true,
    "developmentVerificationRequired": true,
    "productionLiveVerificationRequired": true,
    "directPushToMainAllowed": false,
    "directDevelopmentMutationOfProductionAllowed": false
  },
  "traffic": {
    "cloudflareFirst": true,
    "publicReadsPreferEdgeCache": true,
    "queueWritesUnderPressure": true,
    "selectiveRealtime": true,
    "targetConcurrentUsers": 100000,
    "databaseConcurrencyMustNotTrackUserConcurrencyOneToOne": true
  },
  "liveness": {
    "supabase": {
      "enabled": true,
      "method": "read-only-rpc",
      "rpc": "public.ekodi_keepalive",
      "cadence": "three-times-daily",
      "writesAllowed": false
    },
    "cloudflare": {
      "syntheticKeepalive": false
    }
  },
  "legacyDrain": {
    "projectRef": "lxcxwbdwwojjkgybbqii",
    "noNewProductionDependencies": true,
    "existingProductionDependenciesMustBeMigratedOrRetired": true,
    "destructiveCleanupAllowedBeforeDependencyProof": false
  }
}
