  "legacyCompatibilityAliases": [
    {
      "alias": "/ekodibiz/ekodimall/admin",
      "canonical": "/ekodimall/admin"
    },
    {
      "alias": "/ekodibiz/mall/admin",
      "canonical": "/ekodimall/admin"
    },
    {
      "alias": "/mall/admin",
      "canonical": "/ekodimall/admin"
    }
  ],
  "rules": [
    "The browser-visible operational admin URL is always the managed site's canonical public path plus /admin.",
    "A parent administrator can show child status, search, summaries and links but cannot own a second child-admin route.",
    "Platform /admin routes are reserved for platform-owned control-plane capabilities and directory/observability functions.",
    "A forbidden or legacy aggregate alias may only redirect to the unique canonical site admin during migration; it must never render the child admin UI.",
    "Authorization continues to resolve from Person + Workspace + Role + Capability and never from URL nesting alone.",
    "Every independent admin menu, submenu and detail-management view must have one unique directly addressable canonical URL.",
    "Reload, direct entry and trusted authentication return must restore the same canonical admin route and view state.",
    "Canonical admin descendant URLs follow the registered site/service admin root; pure action buttons do not create routes."
  ],
  "routingContract": {
    "policyId": "ADMIN-ROUTING-001",
    "deepRouteAddressability": true,
    "canonicalDescendantPattern": "{adminPath}/{menu}[/{subpath...}]",
    "reloadRestoresRoute": true,
    "directEntryRestoresRoute": true,
    "authenticationReturnRestoresExactTrustedRoute": true,
    "buttonActionsDoNotCreateRoutes": true
  }
}
