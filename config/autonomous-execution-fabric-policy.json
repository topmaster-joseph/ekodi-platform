{
  "schemaVersion": 3,
  "status": "enforced",
  "generation": 10,
  "defaultChangeClass": "yellow",
  "executionBoundary": {
    "allMutatingWorkRequiresFabric": true,
    "readOnlyObservationMayBypassFabric": true,
    "directHostMutationForbidden": true,
    "providerIndependent": true,
    "providerLockInForbidden": true,
    "singleExecutorMayNotOwnControlAuthority": true
  },
  "orchestration": {
    "owner": "ekodi-orchestrator",
    "mode": "parallel-multi-method-independent-evidence-convergence",
    "virtualizationOnly": false,
    "virtualizedIsolationLaneRequiredForMutatingEngineeringWork": true,
    "minimumIndependentLanes": 2,
    "minimumIndependentMethodClasses": 2,
    "preferredIndependentLanes": 4,
    "maxConcurrentAtS0": 2,
    "selection": {
      "cloudFirst": true,
      "cloudOnly": false,
      "preferReadyBeforeConditional": true,
      "preferIndependentFailureDomains": true,
      "preferDistinctMethodClasses": true,
      "continueHealthyLanesWhenOneLaneFails": true,
      "doNotDuplicateWorkWithoutVerificationValue": true
    },
    "convergence": {
      "requireComparableEvidenceDigest": true,
      "requireIndependentVerification": true,
      "disagreement": "hold-and-collect-more-evidence",
      "insufficientLanes": "degraded-no-promotion",
      "productionPromotion": "central-release-gateway-only",
      "redClass": "explicit-sovereign-human-gate"
    },
    "methodCatalog": [
      {
        "id": "github-hosted-native",
        "methodClass": "cloud-ci-native",
        "state": "runtime-proven",
        "roles": ["build", "test", "contract-validation", "evidence-collection"],
        "mutationBoundary": "ephemeral-workspace-only"
      },
      {
        "id": "rootless-container-sandbox",
        "methodClass": "container-sandbox",
        "state": "runtime-proven",
        "roles": ["isolated-build", "isolated-test", "failure-injection", "dependency-isolation"],
        "mutationBoundary": "rootless-ephemeral-workspace-only"
      },
      {
        "id": "serverless-staging",
        "methodClass": "serverless-cloud",
        "state": "conditional",
        "roles": ["staging-probe", "edge-runtime-verification", "service-contract-test"],
        "requires": ["registered-boundary", "delegated-provider-credential"]
      },
      {
        "id": "database-sandbox",
        "methodClass": "data-sandbox",
        "state": "conditional",
        "roles": ["schema-test", "rls-test", "migration-dry-run", "integration-test"],
        "requires": ["task-needs-data-plane"]
      },
      {
        "id": "browser-e2e",
        "methodClass": "browser-e2e",
        "state": "conditional",
        "roles": ["ui-reproduction", "login-flow-test", "route-test", "post-deploy-verification"],
        "requires": ["browser-capability-available"]
      },
      {
        "id": "authorized-remote-node",
        "methodClass": "remote-node",
        "state": "conditional",
        "roles": ["os-specific-test", "long-running-task", "special-device-test", "local-network-integration"],
        "requires": ["registered-node", "fresh-heartbeat", "task-scoped-delegation"]
      },
      {
        "id": "external-ai-tool-worker",
        "methodClass": "external-ai-tool",
        "state": "conditional",
        "roles": ["independent-analysis", "alternate-implementation", "review", "research", "diagnosis"],
        "requires": ["approved-provider", "task-scoped-capability"],
        "mutationBoundary": "proposal-or-isolated-branch-only"
      }
    ]
  },
  "sandbox": {
    "runtime": "ephemeral-vm-plus-rootless-container",
    "defaultProviderProfile": "s0-default",
    "ephemeral": true,
    "maxConcurrentAtS0": 2,
    "maxLifetimeMinutes": 45,
    "network": {
      "default": "deny",
      "declaredEgressOnly": true
    },
    "filesystem": {
      "workspaceOnly": true,
      "rootFilesystemReadOnly": true,
      "hostMountsForbidden": true,
      "dockerSocketForbidden": true
    },
    "process": {
      "nonRootRequired": true,
      "dropAllCapabilities": true,
      "noNewPrivileges": true
    },
    "secrets": {
      "productionSecretsForbidden": true,
      "shortLivedScopedCredentialsOnly": true
    }
  },
  "providers": {
    "selection": "risk-cost-capability-aware",
    "fallbackMustPreserveOrIncreaseIsolation": true,
    "profiles": {
      "s0-default": {
        "provider": "github-hosted-ephemeral-vm",
        "innerRuntime": "rootless-podman",
        "status": "runtime-proven",
        "paidCommitmentRequired": false
      },
      "strong-vm": {
        "provider": "cloudflare-sandbox",
        "status": "candidate-not-activated",
        "activationRequires": [
          "existing-paid-entitlement-or-sovereign-budget-approval",
          "provider-adapter-runtime-proof",
          "cost-budget-evidence"
        ]
      },
      "high-isolation": {
        "provider": "gvisor-or-firecracker-compatible-runtime",
        "status": "future-conditional",
        "activationRequires": [
          "documented-threat-model",
          "dedicated-capacity-justification",
          "runtime-proof",
          "cost-budget-evidence"
        ]
      }
    }
  },
  "risk": {
    "green": {
      "mayImplement": true,
      "mayTest": true,
      "mayOpenPullRequest": true,
      "mayPromoteToProduction": false
    },
    "yellow": {
      "mayImplement": true,
      "mayTest": true,
      "mayOpenPullRequest": true,
      "requiresRollbackDefinition": true,
      "requiresVerificationDefinition": true,
      "mayPromoteToProduction": false
    },
    "red": {
      "mayImplement": false,
      "mayPreparePlanAndPatch": true,
      "requiresExplicitSovereignGateBeforeExecution": true,
      "mayPromoteToProduction": false
    }
  },
  "promotion": {
    "directProductionMutationForbidden": true,
    "immutableVerifiedArtifactRequired": true,
    "parallelIndependentEvidenceRequired": true,
    "minimumIndependentEvidenceSources": 2,
    "stagingRequired": true,
    "postStagingVerificationRequired": true,
    "releaseAuthorizationRequired": true,
    "postProductionVerificationRequired": true,
    "automaticRecoveryRequiredOnFailedVerification": true
  },
  "evidence": {
    "initialRuntimeProof": "evidence/runtime/autonomous-execution-fabric/2026-09-17-initial-proof.json",
    "persist": [
      "request",
      "authority_context",
      "risk_classification",
      "base_commit",
      "patch_or_commit",
      "execution_provider",
      "execution_method_class",
      "parallel_lane_results",
      "convergence_result",
      "isolation_profile",
      "build_result",
      "test_result",
      "verification_result",
      "artifact_digest",
      "staging_result",
      "release_authorization",
      "production_result",
      "recovery_result"
    ]
  }
}
