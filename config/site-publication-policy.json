{
  "id": "EKODI-SITE-PUBLICATION-001",
  "version": 1,
  "status": "enforced",
  "owner": "ekodi-orchestrator",
  "finalAuthority": "ekodi-platform-super-administrator",
  "scope": "all-current-and-future-public-user-and-independent-sites",
  "stateSource": "public_site_controls",
  "autoEnrollFutureSites": true,
  "defaultStatus": "public",
  "allowedStatuses": [
    "public",
    "private",
    "maintenance"
  ],
  "explicitAdministratorChangeRequired": true,
  "publicBeforeLogin": true,
  "privateRobots": "noindex, nofollow, noarchive",
  "maintenanceRobots": "noindex, nofollow, noarchive",
  "protectedRouteBypass": [
    "admin",
    "api",
    "auth",
    "shell",
    "health",
    "static-assets"
  ],
  "authority": {
    "platformSuperAdmin": "all-sites",
    "siteAdmin": "own-site-only",
    "crossSiteSiteAdminMutation": false
  },
  "safety": {
    "preserveAdminAccessWhenPrivate": true,
    "preserveAuthenticationWhenPrivate": true,
    "preserveApiOperationsWhenPrivate": true,
    "localOverrideForbidden": true,
    "auditEveryMutation": true,
    "failOpenOnReadFailure": true
  },
  "ui": {
    "platformAdmin": "/admin#public-site-controls",
    "siteAdmin": "injected-site-local-publication-control",
    "simpleSelector": true,
    "advancedMaintenanceOptions": "progressive-disclosure"
  }
}
