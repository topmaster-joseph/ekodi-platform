{
  "schemaVersion": 1,
  "policyId": "PERSONAL-CREDENTIAL-VAULT-001",
  "status": "design-review",
  "productionActivationDefault": false,
  "canonicalSurface": "https://ekodi.kr/my/security/vault",
  "layer": "system",
  "purpose": "Store user-owned login secrets and recovery material with least privilege while keeping provider OAuth credentials in their existing service-specific vaults.",
  "ownership": {
    "scope": "person",
    "canonicalIdentityRequired": true,
    "workspaceSecretsUseSeparateVaults": true,
    "centralAdminPlaintextAccess": false,
    "supportStaffPlaintextAccess": false
  },
  "secretClasses": {
    "allowed": [
      "password",
      "recovery_code",
      "api_key",
      "totp_seed",
      "secure_note"
    ],
    "metadataOnly": [
      "passkey_reference",
      "oauth_connection_reference",
      "recovery_email",
      "recovery_phone"
    ],
    "forbidden": [
      "payment_card_cvv",
      "government_identity_document",
      "biometric_template"
    ],
    "oauthRule": "Refresh/access tokens stay in service-specific OAuth vaults; the personal vault stores references only."
  },
  "cryptography": {
    "contentCipher": "AES-256-GCM",
    "nonceBytes": 12,
    "envelopeEncryption": true,
    "perPersonDataEncryptionKey": true,
    "itemSpecificNonceRequired": true,
    "aadBinds": [
      "owner_person_id",
      "vault_id",
      "item_id",
      "secret_kind",
      "schema_version"
    ],
    "kekSource": "server-secret-or-managed-secret-store",
    "kekRotationRequired": true,
    "plaintextAtRestForbidden": true,
    "plaintextInLogsForbidden": true
  },
  "access": {
    "listNeverDecrypts": true,
    "searchMetadataOnly": true,
    "stepUpRequiredFor": [
      "reveal",
      "copy",
      "edit_secret",
      "export",
      "delete",
      "rotate_key"
    ],
    "stepUpPreferred": "passkey",
    "stepUpFallback": "fresh_identity_reauthentication",
    "revealWindowSeconds": 30,
    "autoLockMinutes": 5,
    "export": "encrypted-only",
    "mcpSecretRevealExposure": false,
    "aiSecretRevealExposure": false,
    "externalAiSecretForwarding": false
  },
  "privacy": {
    "secretValuesExcludedFromAnalytics": true,
    "secretValuesExcludedFromAiContext": true,
    "secretValuesExcludedFromSearchIndex": true,
    "auditStoresSecretValues": false,
    "clipboardClearBestEffortOnly": true
  },
  "recovery": {
    "serverManagedMode": "recoverable-with-verified-identity-and-key-rotation",
    "zeroKnowledgeMode": "future-opt-in-user-held-unlock-key",
    "zeroKnowledgeRecoveryWarningRequired": true
  },
  "activationGates": [
    "security-review",
    "cryptography-tests",
    "authorization-tests",
    "step-up-auth-tests",
    "secret-redaction-tests",
    "backup-and-key-rotation-test",
    "production-canary-with-synthetic-secrets"
  ],
  "legacyAliasDeclaration": "forbidden"
}
