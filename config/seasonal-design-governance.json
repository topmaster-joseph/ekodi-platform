{
  "version": "1.0.0",
  "timezone": "Asia/Seoul",
  "purpose": "Allow EKODI Chief AI to observe seasonal and event context, propose visual refreshes, stage reversible changes, verify them, and report results without allowing seasonal decoration to override service identity, accessibility, reliability, or human authority. Public EKODI service selectors may also use a pre-approved, provider-independent, deterministic weekly visual rotation that does not require a new production deployment for each cycle.",
  "principles": [
    "service_identity_before_season",
    "season_is_a_thin_visual_layer_not_a_redesign",
    "accessibility_before_aesthetic_novelty",
    "reversible_changes_before_irreversible_changes",
    "staging_before_production",
    "production_requires_post_release_verification",
    "no_ai_provider_dependency_for_core_service",
    "report_what_changed_and_how_to_roll_back"
  ],
  "decisionLoop": ["observe_context","compare_current_surface","propose","classify_change","policy_check","generate_or_select_assets","stage","verify","promote_if_authorized","verify_public_host","report","measure","rollback_if_needed"],
  "signals": {
    "calendarSeason": true,
    "localTimezone": "Asia/Seoul",
    "liturgicalCalendar": "service_specific_and_human_maintained_when_used",
    "organizationEvents": "optional",
    "campaignCalendar": "optional",
    "manualOverride": true,
    "manualOverridePrecedence": "highest"
  },
  "calendarSeasons": {
    "spring": {"months":[3,4,5],"intent":"renewal, openness, gentle vitality"},
    "summer": {"months":[6,7,8],"intent":"clarity, lightness, spacious energy"},
    "autumn": {"months":[9,10,11],"intent":"maturity, harvest, warmth, reflection"},
    "winter": {"months":[12,1,2],"intent":"stillness, warmth, focus, durable hope"}
  },
  "runtimeRotation": {
    "mode": "preapproved_deterministic",
    "surface": "public",
    "timezone": "Asia/Seoul",
    "cycle": "weekly",
    "cycleDays": 7,
    "requiresDeploymentPerCycle": false,
    "providerIndependent": true,
    "manualOverridePrecedence": "highest",
    "allowed": ["service_selector_accent","service_selector_glow","ambient_identity_rail","public_experience_css_tokens"],
    "forbidden": ["site_layout_change","content_reorder","navigation_relocation","copy_claim_change","authentication_meaning_change","transaction_meaning_change","contrast_reduction","unverified_remote_asset"],
    "notes": "This is a pre-approved runtime presentation contract, not autonomous production deployment. It may vary only thin Shell presentation tokens within each service visual DNA."
  },
  "changeClasses": {
    "minor_reversible": {
      "examples": ["hero_background_asset","seasonal_illustration","ambient_background_texture","small_decorative_accent","seasonal_microcopy","non_structural_color_accent_within_service_dna"],
      "autonomy": "guarded_auto_when_service_policy_allows",
      "requirements": ["staging_verified","responsive_verified","contrast_verified","performance_budget_passed","rollback_reference_recorded","post_release_public_host_verified"]
    },
    "material_brand_change": {
      "examples": ["logo_change","primary_brand_palette_change","headline_typography_change","navigation_structure_change","information_architecture_change","core_homepage_message_change","major_motion_system_change","service_visual_family_change"],
      "autonomy": "human_gate",
      "requirements": ["administrator_approval","staging_verified","rollback_plan"]
    },
    "forbidden_automatic": {
      "examples": ["remove_accessibility_controls","reduce_contrast_below_policy","hide_service_identity","replace_religious_or_organizational_identity_with_generic_seasonal_branding","publish_unverified_ai_generated_claims","production_change_without_rollback_path"],
      "autonomy": "never"
    }
  },
  "verification": {
    "required": ["desktop_layout","mobile_layout","keyboard_focus","text_contrast","text_over_image_readability","asset_loading","layout_shift","broken_links","service_identity_markers","public_host_smoke_test"],
    "performance": {"preferOptimizedAssets":true,"avoidHeroAssetRegression":true,"lazyLoadBelowFold":true}
  },
  "reporting": {
    "administratorReportRequired": true,
    "fields": ["reason","service","season_or_event","change_class","before_reference","after_reference","staging_result","production_result","public_host_result","rollback_reference","metric_watch","exceptions"],
    "reportEvenWhenNoChange": false
  },
  "servicePolicies": {
    "default": {"seasonWeight":"low","eventWeight":"medium","autoStage":true,"autoProductionMinor":false,"notes":"Propose and stage minor reversible changes, but require administrator approval for production unless the service has an explicit exception below.","runtimePublicRotation":true},
    "church": {"seasonWeight":"medium","eventWeight":"high","priorityContext":"liturgical_calendar_before_meteorological_season","autoStage":true,"autoProductionMinor":true,"protected":["worship_readability","scripture_prominence","sacred_tone","church_identity"],"notes":"Seasonal imagery may support worship, but liturgical and ministry context outrank generic seasonal decoration.","runtimePublicRotation":true},
    "community": {"seasonWeight":"high","eventWeight":"high","priorityContext":"participation_and_real_world_gathering","autoStage":true,"autoProductionMinor":true,"protected":["relational_warmth","participation_clarity","community_identity"],"runtimePublicRotation":true},
    "cafe": {"seasonWeight":"high","eventWeight":"medium","priorityContext":"future_place_imagination_and_harbor_identity","autoStage":true,"autoProductionMinor":true,"protected":["future_place_truthfulness","harbor_identity","accessibility","clear_preopening_state"],"notes":"Seasonal ambience may make the imagined place feel alive, but must never imply that the physical cafe is open, staffed, bookable, or serving real-time menus before verified opening.","runtimePublicRotation":true},
    "social": {"seasonWeight":"medium","eventWeight":"high","priorityContext":"current_stream_and_media_context","autoStage":true,"autoProductionMinor":true,"runtimePublicRotation":true},
    "messenger": {"seasonWeight":"low","eventWeight":"high","priorityContext":"conversation_clarity_and_urgent_context","autoStage":true,"autoProductionMinor":false,"protected":["message_readability","presence_state","handoff_clarity","workspace_context"],"notes":"Seasonal ambience may be staged, but threads, unread state, alerts and human handoff cues must remain visually stable.","runtimePublicRotation":true},
    "biz": {"seasonWeight":"low","eventWeight":"medium","priorityContext":"trust_and_business_clarity","autoStage":true,"autoProductionMinor":false,"notes":"Do not trade executive credibility for decorative seasonality.","runtimePublicRotation":true},
    "business": {"seasonWeight":"low","eventWeight":"medium","priorityContext":"operational_clarity","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "management": {"seasonWeight":"low","eventWeight":"medium","priorityContext":"decision_clarity_and_next_action","autoStage":true,"autoProductionMinor":false,"protected":["question_first_entry","decision_hierarchy","next_action_clarity"],"runtimePublicRotation":true},
    "bible": {"seasonWeight":"medium","eventWeight":"high","priorityContext":"scripture_and_community_context_before_generic_season","autoStage":true,"autoProductionMinor":false,"protected":["scripture_distinction","reflection_readability","pastoral_safety","private_journey_boundary"],"notes":"Seasonal ambience may support warmth and reflection but must never overpower Scripture, imply revelation, or blur private sharing boundaries.","runtimePublicRotation":true},
    "life": {"seasonWeight":"medium","eventWeight":"medium","priorityContext":"human_question_and_reflection","autoStage":true,"autoProductionMinor":false,"protected":["question_clarity","non_coercive_guidance","service_handoff_clarity"],"runtimePublicRotation":true},
    "delivery": {"seasonWeight":"low","eventWeight":"medium","priorityContext":"dispatch_clarity_and_local_conditions","autoStage":true,"autoProductionMinor":false,"protected":["route_status","operational_action","delivery_state"],"runtimePublicRotation":true},
    "marketing": {"seasonWeight":"high","eventWeight":"high","priorityContext":"campaign_relevance_without_deceptive_urgency","autoStage":true,"autoProductionMinor":true,"runtimePublicRotation":true},
    "mall": {"seasonWeight":"high","eventWeight":"high","priorityContext":"discovery_and_merchandising","autoStage":true,"autoProductionMinor":true,"runtimePublicRotation":true},
    "books": {"seasonWeight":"medium","eventWeight":"medium","priorityContext":"editorial_curation","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "publishing": {"seasonWeight":"low","eventWeight":"medium","priorityContext":"professional_publishing_workflow_and_release_calendar","autoStage":true,"autoProductionMinor":false,"protected":["publishing_workflow_clarity","manuscript_and_proof_status","distribution_truthfulness","bookstore_service_separation"],"notes":"Seasonal ambience may support the publishing studio, but must not blur production status, distribution claims, or the independent boundary between Publishing and EKODI Bookstore.","runtimePublicRotation":true},
    "author": {"seasonWeight":"low","eventWeight":"medium","priorityContext":"creative_focus","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "lab": {"seasonWeight":"low","eventWeight":"low","priorityContext":"evidence_and_research_clarity","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "work": {"seasonWeight":"low","eventWeight":"low","priorityContext":"task_efficiency","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "energy": {"seasonWeight":"medium","eventWeight":"medium","priorityContext":"energy_conditions_and_stewardship","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "my": {"seasonWeight":"medium","eventWeight":"medium","priorityContext":"personal_calm_and_orientation","autoStage":true,"autoProductionMinor":true,"notes":"Seasonal ambience may change automatically but navigation, workspace visibility, account state, and service access must not move.","runtimePublicRotation":true},
    "trade": {"seasonWeight":"low","eventWeight":"medium","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "invest": {"seasonWeight":"none","eventWeight":"low","priorityContext":"evidence_risk_and_decision_clarity","autoStage":true,"autoProductionMinor":false,"protected":["risk_language","evidence_status","diligence_state","regulatory_scope"],"notes":"Do not use seasonal urgency, scarcity or celebratory styling to influence investment judgment.","runtimePublicRotation":true},
    "pay": {"seasonWeight":"none","eventWeight":"low","autoStage":false,"autoProductionMinor":false,"runtimePublicRotation":true},
    "insurance": {"seasonWeight":"low","eventWeight":"low","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "edu": {"seasonWeight":"medium","eventWeight":"high","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "media": {"seasonWeight":"medium","eventWeight":"high","autoStage":true,"autoProductionMinor":true,"runtimePublicRotation":true},
    "mail": {"seasonWeight":"none","eventWeight":"low","autoStage":false,"autoProductionMinor":false,"runtimePublicRotation":true},
    "live": {"seasonWeight":"low","eventWeight":"high","autoStage":true,"autoProductionMinor":false,"runtimePublicRotation":true},
    "cloud": {"seasonWeight":"none","eventWeight":"low","autoStage":false,"autoProductionMinor":false,"runtimePublicRotation":true}
  }
}
