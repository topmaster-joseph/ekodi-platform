{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ekodi-platform-development",
  "main": "platform-router-entry-worker.js",
  "account_id": "46aad4738793fbaca88574832a2ccc0f",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ENVIRONMENT": "staging"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
