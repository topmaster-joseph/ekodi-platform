{
  "version": 1,
  "worker": {
    "name": "ekodi-service-proxy",
    "config": "wrangler.service-proxy.toml",
    "requests": [
      {"url":"https://ekodi.kr/ekodibiz/","statuses":[200],"redirect":"follow","expect":["EKODI BIZ","https://ekodi.kr/shell/shell.js"]},
      {"url":"https://ekodi.kr/ekodichurch/","statuses":[200],"redirect":"follow","expect":["https://ekodi.kr/shell/shell.js"]},
      {"url":"https://ekodi.kr/ekodilab/","statuses":[200],"redirect":"follow","expect":["https://ekodi.kr/shell/shell.js"]},
      {"url":"https://ekodi.kr/ekodimall/","statuses":[308],"redirect":"manual","headerExpect":["location: https://ekodi.kr/ekodimall"]},
      {"url":"https://ekodi.kr/ekodimall/","statuses":[308],"redirect":"manual","headerExpect":["location: https://ekodi.kr/ekodimall"]}
    ]
  }
}
