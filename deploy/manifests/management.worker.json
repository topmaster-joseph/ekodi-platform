{
  "version": 1,
  "worker": {
    "name": "ekodi-management",
    "config": "wrangler.management.toml",
    "requests": [
      {
        "url": "https://management.ekodi.kr/",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "경영플랫폼",
          "무료로 시작하기",
          "site=management",
          "https://ekodi.kr/shell/shell.js",
          "https://ekodi.kr/auth/?site=management"
        ],
        "headerExpect": [
          "x-ekodi-shell: v2"
        ]
      },
      {
        "url": "https://management.ekodi.kr/config.js",
        "statuses": [
          200
        ],
        "expect": [
          "production-foundation",
          "site=management",
          "\"executionEnabled\":false",
          "\"minimumTier\":\"free\"",
          "https://ekodi.kr/auth/?site=management"
        ]
      },
      {
        "url": "https://management.ekodi.kr/api/catalog",
        "statuses": [
          200
        ],
        "expect": [
          "\"guestMode\":\"guide-only\"",
          "마케팅AI",
          "메뉴AI",
          "주문AI",
          "리뷰AI",
          "프랜차이즈"
        ]
      },
      {
        "url": "https://ekodi.kr/management/",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "경영플랫폼",
          "https://ekodi.kr/auth/?site=management"
        ],
        "headerExpect": [
          "x-ekodi-shell: v2"
        ]
      },
      {
        "url": "https://ekodi.kr/management/config.js",
        "statuses": [
          200
        ],
        "expect": [
          "production-foundation",
          "https://ekodi.kr/auth/?site=management",
          "\"executionEnabled\":false"
        ]
      },
      {
        "url": "https://ekodi.kr/management/api/catalog",
        "statuses": [
          200
        ],
        "expect": [
          "\"guestMode\":\"guide-only\"",
          "마케팅AI",
          "주문AI"
        ]
      },
      {
        "url": "https://ekodi.kr/management/api/spaces",
        "statuses": [
          401
        ],
        "expect": [
          "\"error\":\"unauthorized\""
        ]
      }
    ]
  }
}
