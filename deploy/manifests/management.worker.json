{
  "version": 1,
  "worker": {
    "name": "ekodi-management",
    "config": "wrangler.management.toml",
    "requests": [
      {
        "url": "https://ekodi.kr/management/",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "경영플랫폼",
          "https://ekodi.kr/auth/?site=management"
        ],
        "headerExpect": [
          "x-ekodi-shell: v2"
        ]
      },
      {
        "url": "https://ekodi.kr/management/config.js",
        "statuses": [
          200
        ],
        "expect": [
          "production-foundation",
          "https://ekodi.kr/auth/?site=management",
          "\"executionEnabled\":false"
        ]
      },
      {
        "url": "https://ekodi.kr/management/api/catalog",
        "statuses": [
          200
        ],
        "expect": [
          "\"guestMode\":\"guide-only\"",
          "마케팅AI",
          "주문AI"
        ]
      },
      {
        "url": "https://ekodi.kr/management/api/spaces",
        "statuses": [
          401
        ],
        "expect": [
          "\"error\":\"unauthorized\""
        ]
      },
      {
        "url": "https://ekodi.kr/management/api/store-summary?slug=jadam",
        "statuses": [
          401
        ],
        "expect": [
          "\"error\":\"unauthorized\""
        ]
      }
    ]
  }
}
