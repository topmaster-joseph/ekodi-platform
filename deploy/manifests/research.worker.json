{
  "version": 1,
  "worker": {
    "name": "ekodi-research",
    "config": "wrangler.research.toml",
    "allowFirstDeploy": true,
    "requests": [
      {
        "url": "https://ekodi.kr/research/",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "EKODI Research",
          "무료 연구진단",
          "나의 연구실"
        ],
        "headerExpect": [
          "x-ekodi-shell: v2"
        ]
      },
      {
        "url": "https://ekodi.kr/research/health",
        "statuses": [
          200
        ],
        "expect": [
          "ekodi-research",
          "\"phase\":\"foundation\"",
          "\"privateDocuments\":false",
          "\"aiExecution\":false"
        ]
      },
      {
        "url": "https://ekodi.kr/research/api/projects",
        "statuses": [
          503
        ],
        "expect": [
          "research_storage_not_configured"
        ]
      }
    ]
  }
}
