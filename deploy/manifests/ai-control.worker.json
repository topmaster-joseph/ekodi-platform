{
  "version": 2,
  "worker": {
    "name": "ekodi-ai-control",
    "config": "wrangler.ai.release.toml",
    "allowFirstDeploy": true,
    "requests": [
      {
        "url": "https://ekodi.kr/ai/",
        "statuses": [
          200
        ],
        "redirect": "manual",
        "expect": [
          "EKODI 모두의 AI 프로젝트",
          "무엇을 원하세요?"
        ],
        "headerExpect": [
          "x-ekodi-ai-entry: commons-v1"
        ]
      },
      {
        "url": "https://ekodi.kr/ai/__health",
        "statuses": [
          200
        ],
        "expect": [
          "\"ok\":true",
          "\"platform\":\"ai-control\"",
          "\"commons\":true"
        ]
      },
      {
        "url": "https://ekodi.kr/ai/api/commons/services",
        "statuses": [
          200
        ],
        "expect": [
          "\"principle\"",
          "\"categories\""
        ]
      },
      {
        "url": "https://ekodi.kr/ai/api/commons/requests",
        "statuses": [
          200
        ],
        "expect": [
          "\"requests\""
        ]
      },
      {
        "url": "https://ekodi.kr/ai/api/commons/ideas",
        "statuses": [
          401
        ],
        "expect": [
          "authentication_required"
        ]
      }
    ]
  }
}
