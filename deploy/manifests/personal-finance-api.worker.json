{
  "version": 1,
  "worker": {
    "name": "ekodi-personal-finance-api",
    "config": "wrangler.personal-finance.toml",
    "allowFirstDeploy": true,
    "requests": [
      {
        "url": "https://ekodi.kr/personal-finance-api/health",
        "statuses": [
          200
        ],
        "expect": [
          "\"ok\":true",
          "ekodi-personal-finance-api",
          "\"dataBoundary\":\"dedicated-d1\"",
          "\"referenceService\":true",
          "\"actionCeiling\":\"L2\"",
          "\"evidenceLinked\":true",
          "\"version\":3",
          "\"adminControl\":true",
          "\"personalDataAdminReadable\":false"
        ]
      },
      {
        "url": "https://ekodi.kr/personal-finance-api/api/finance/personal/summary",
        "statuses": [
          401
        ]
      },
      {
        "url": "https://ekodi.kr/personal-finance-api/api/finance/personal/controls",
        "statuses": [
          401
        ]
      },
      {
        "url": "https://ekodi.kr/personal-finance-api/api/finance/personal/insights",
        "statuses": [
          401
        ]
      },
      {
        "url": "https://ekodi.kr/personal-finance-api/api/admin/personal-finance/control",
        "statuses": [
          401
        ]
      }
    ]
  }
}
