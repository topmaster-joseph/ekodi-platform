{
  "version": 1,
  "worker": {
    "name": "ekodi-space",
    "config": "wrangler.space.toml",
    "requests": [
      {
        "url": "https://space.ekodi.kr/",
        "statuses": [200],
        "redirect": "manual",
        "expect": ["OPERATING SPACE", "로그인하고 내 공간 보기", "workspace ID"],
        "headerExpect": ["x-ekodi-service: space", "cache-control: no-store", "x-robots-tag: noindex, nofollow, noarchive"]
      },
      {
        "url": "https://space.ekodi.kr/health",
        "statuses": [200],
        "redirect": "manual",
        "expect": ["ekodi-space", "legacy-operating-space-compatibility", "workspace-id", "public_namespace"],
        "headerExpect": ["x-ekodi-service: space", "cache-control: no-store"]
      },
      {
        "url": "https://space.ekodi.kr/org/cgma",
        "statuses": [308],
        "redirect": "manual",
        "expect": [],
        "headerExpect": ["location: https://ekodi.kr/cgma", "x-ekodi-service: space", "x-ekodi-route: legacy-space-redirect"]
      }
    ]
  }
}
