{
  "version": 2,
  "targets": [
    {
      "name": "Marketing AI Hub",
      "project": "marketing-ai",
      "directory": "dist/marketing-ai",
      "productionUrl": "https://marketing.ekodi.kr/",
      "expect": [
        "id=\"freeTrialForm\"",
        "data-public-landing-cleanup",
        "id=\"googleCustomerAuth\"",
        "needsAuthClient=Boolean",
        "data-ekodi-handoff-scrub",
        "authTokenWhenReady",
        "data-progressive-guidance"
      ],
      "forbid": [
        "id=\"trialStore\"",
        "class=\"case-list\"",
        "href=\"https://pay.ekodi.kr",
        "import{createClient}from'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';"
      ]
    },
    {
      "name": "Jadam Marketing AI",
      "project": "marketing-ai-jadam",
      "directory": "dist/marketing-ai/jadam",
      "productionUrl": "https://jadam.ai.ekodi.kr/",
      "expect": [
        "자담치킨 목포대점",
        "id=\"googleCustomerAuth\"",
        "Google로 무료 시작"
      ],
      "forbid": [
        "id=\"customerAuthOpen\"",
        "/api/customer/login",
        "/api/customer/accept-invite"
      ]
    },
    {
      "name": "Pizzamaru Marketing AI",
      "project": "marketing-ai-pizzamaru",
