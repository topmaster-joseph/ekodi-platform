        "Google로 무료 시작"
      ],
      "forbid": [
        "id=\"customerAuthOpen\"",
        "/api/customer/login",
        "/api/customer/accept-invite"
      ]
    },
    {
      "name": "Yogurt Marketing AI",
      "project": "marketing-ai-yogurtpurple",
      "directory": "dist/marketing-ai/yogurtpurple",
      "productionUrl": "https://yogurt.ai.ekodi.kr/",
      "expect": [
        "요거트퍼플 목포대점",
