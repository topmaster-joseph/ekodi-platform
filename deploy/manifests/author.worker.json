{
  "version": 1,
  "worker": {
    "name": "ekodi-author-ai",
    "config": "wrangler.author.toml",
    "requests": [
      {
        "url": "https://author.ekodi.kr/",
        "statuses": [200],
        "redirect": "manual",
        "expect": ["EKODI Creator AI", "Creator AI가 세상과 연결될 형태로 만듭니다", "CREATOR APPROVED"],
        "headerExpect": ["x-ekodi-service: author-ai", "x-ekodi-product: creator-ai", "x-content-type-options: nosniff"]
      },
      {
        "url": "https://author.ekodi.kr/health",
        "statuses": [200],
        "redirect": "manual",
        "expect": ["ekodi-author-ai", "ekodi-creator-ai", "author-events-v1", "myEkodiPortfolio", "booksHandoff"],
        "headerExpect": ["x-ekodi-service: author-ai", "x-ekodi-product: creator-ai", "cache-control: no-store"]
      }
    ]
  }
}
