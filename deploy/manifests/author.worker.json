{
  "version": 1,
  "worker": {
    "name": "ekodi-author-ai",
    "config": "wrangler.author.toml",
    "requests": [
      {
        "url": "https://author.ekodi.kr/",
        "statuses": [200],
        "redirect": "manual",
        "expect": ["EKODI Author AI", "생각을 꺼내면", "저자AI가 책의 길을 만듭니다"],
        "headerExpect": ["x-ekodi-service: author-ai", "x-content-type-options: nosniff"]
      },
      {
        "url": "https://author.ekodi.kr/health",
        "statuses": [200],
        "redirect": "manual",
        "expect": ["ekodi-author-ai", "author-events-v1", "booksHandoff"],
        "headerExpect": ["x-ekodi-service: author-ai", "cache-control: no-store"]
      }
    ]
  }
}
