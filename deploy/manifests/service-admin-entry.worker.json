{
  "version": 1,
  "worker": {
    "name": "ekodi-service-admin-entry",
    "config": "wrangler.service-admin-entry.toml",
    "allowFirstDeploy": true,
    "dnsRetiredHosts": [
      "auth.ekodi.kr",
      "cloud.ekodi.kr",
      "live.ekodi.kr",
      "live.biz.ekodi.kr",
      "live.church.ekodi.kr",
      "live.lab.ekodi.kr",
      "trade.ekodi.kr",
      "trade.biz.ekodi.kr",
      "invest.ekodi.kr",
      "messenger.ekodi.kr"
    ],
    "requests": [
      {
        "url": "https://ai.ekodi.kr/admin",
        "statuses": [307],
        "redirect": "manual",
        "headerExpect": ["location: https://ekodi.kr/admin/?source=", "cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"],
        "rollbackHeaderExpect": ["cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"]
      },
      {
        "url": "https://mail.biz.ekodi.kr/admin",
        "statuses": [307],
        "redirect": "manual",
        "headerExpect": ["location: https://ekodi.kr/admin/?source=", "cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"],
        "rollbackHeaderExpect": ["cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"]
      },
      {
        "url": "https://mail.church.ekodi.kr/admin",
        "statuses": [307],
        "redirect": "manual",
        "headerExpect": ["location: https://ekodi.kr/admin/?source=", "cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"],
        "rollbackHeaderExpect": ["cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"]
      },
      {
        "url": "https://management.ekodi.kr/admin",
        "statuses": [307],
        "redirect": "manual",
        "headerExpect": ["location: https://ekodi.kr/admin/?source=", "cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"],
        "rollbackHeaderExpect": ["cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"]
      },
      {
        "url": "https://marketing-api.ekodi.kr/admin",
        "statuses": [307],
        "redirect": "manual",
        "headerExpect": ["location: https://ekodi.kr/admin/?source=", "cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"],
        "rollbackHeaderExpect": ["cache-control: no-store", "x-ekodi-admin-entry: central-handoff-v1"]
      }
    ]
  }
}
