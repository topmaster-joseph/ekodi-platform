{
  "version": 1,
  "worker": {
    "name": "ekodi-community",
    "config": "wrangler.community.toml",
    "requests": [
      {
        "url": "https://ekodi.kr/community/",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "Community",
          "/social-links.js"
        ]
      },
      {
        "url": "https://ekodi.kr/community/social-links.js",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "ekodi.kr/api/social/registry"
        ]
      },
      {
        "url": "https://ekodi.kr/community/reading/",
        "statuses": [
          200
        ],
        "redirect": "manual",
        "expect": [
          "함께읽기",
          "id=\"sharedWorkspace\"",
          "/community/reading/app.js"
        ],
        "rollbackVerify": false
      },
      {
        "url": "https://ekodi.kr/community/reading/app.js?rv=reading-shared-20261103-a",
        "statuses": [
          200
        ],
        "redirect": "manual",
        "expect": [
          "initializeMeetingUI",
          "initializeSharedWorkspace",
          "shareConsent"
        ],
        "rollbackVerify": false
      },
      {
        "url": "https://ekodi.kr/community/reading/topics.js?rv=meeting-20261103-b",
        "statuses": [
          200
        ],
        "redirect": "manual",
        "expect": [
          "createMeetingState",
          "formatMeetingClock"
        ],
        "rollbackVerify": false
      },
      {
        "url": "https://ekodi.kr/community/health",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "\"socialRegistry\":true"
        ]
      }
    ]
  }
}
