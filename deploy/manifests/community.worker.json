{
  "version": 1,
  "worker": {
    "name": "ekodi-community",
    "config": "wrangler.community.toml",
    "requests": [
      {
        "url": "https://ekodi.kr/community/",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "Community",
          "/social-links.js"
        ],
        "candidateUrl": "https://ekodi-community.topmaster-joseph.workers.dev/"
      },
      {
        "url": "https://ekodi.kr/community/social-links.js",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "ekodi.kr/api/social/registry"
        ],
        "candidateUrl": "https://ekodi-community.topmaster-joseph.workers.dev/social-links.js"
      },
      {
        "url": "https://ekodi.kr/community/health",
        "statuses": [
          200
        ],
        "redirect": "follow",
        "expect": [
          "\"socialRegistry\":true"
        ],
        "candidateUrl": "https://ekodi-community.topmaster-joseph.workers.dev/health"
      }
    ]
  }
}
