{
  "schemaVersion": 2,
  "architectureVersion": "1.1.0",
  "status": "active-phase1",
  "name": "EKODI Autonomous Execution Fabric",
  "generation": 10,
  "generationLabel": "Self-Architecture Optimization",
  "purpose": "Provide a sovereign, isolated, provider-independent and auditable execution environment in which EKODI can implement, test, verify, recover and package code or service changes without depending on a single external AI session, operator workstation, remote desktop session, cloud vendor or production runtime.",
  "constitutionalAlignment": {
    "authorityModel": "Person + Workspace + Role + Capability",
    "directProductionMutationForbidden": true,
    "humanGateRequiredForRedClass": true,
    "immutablePromotionRequired": true,
    "rollbackRequired": true,
    "auditRequired": true,
    "providerMayNotOwnCanonicalAuthority": true,
    "virtualizationFirst": true,
    "failClosedWhenIsolationUnavailable": true
  },
  "operatingModel": {
    "controlPlane": "persistent-low-cost",
    "executionPlane": "ephemeral-virtualized-isolated-sandbox",
    "defaultIsolationProfile": "standard",
    "isolationEscalation": "standard-to-hardened-to-microvm",
    "sharedBeforeDedicated": true,
    "modularMonolithFirst": true,
    "scaleTier": "S0",
    "noAlwaysOnPerAgentRuntime": true,
    "persistentOperatorHostMayExecuteRepositoryCode": false,
    "controlPlaneMayCoordinateWithoutExecutingRepositoryCode": true
  },
  "isolationProfiles": {
    "standard": {
      "technologyClass": "rootless-oci-container",
      "purpose": "Normal trusted repository code, builds, tests, validation and packaging.",
      "requiredProperties": [
        "ephemeral",
        "workspace_isolation",
        "read_only_root_filesystem",
        "network_deny_by_default",
        "capabilities_dropped",
        "no_new_privileges",
        "resource_limits",
        "no_host_container_socket",
        "no_production_secrets"
      ]
    },
    "hardened": {
      "technologyClass": "gvisor-or-equivalent-application-kernel",
      "purpose": "Untrusted executables or workloads where direct host-kernel attack surface should be reduced.",
      "inherits": "standard",
      "requiredProperties": [
        "separate_application_kernel_or_equivalent_strong_sandbox"
      ]
    },
    "microvm": {
      "technologyClass": "firecracker-or-equivalent-microvm",
      "purpose": "Kernel-sensitive tooling, stronger tenant separation or VM-grade isolation.",
      "inherits": "hardened",
      "requiredProperties": [
        "hardware_virtualization_boundary_or_equivalent",
        "dedicated_unprivileged_runtime_identity",
        "jailer_or_equivalent_process_confinement"
      ]
    }
  },
  "technologyBaseline": {
    "rootlessContainers": "Podman-compatible rootless OCI execution with user namespaces",
    "hardenedSandbox": "gVisor runsc or equivalent application-kernel isolation",
    "microvm": "Firecracker with jailer or equivalent microVM isolation",
    "cloudAuthentication": "OIDC or equivalent short-lived federated credentials when supported",
    "supplyChain": "SLSA-compatible provenance and immutable artifact digests",
    "workflowDependencies": "third-party GitHub Actions pinned to immutable full commit SHAs in execution-fabric workflows"
  },
  "components": [
    {
      "id": "execution-control-plane",
      "responsibilities": [
        "receive_authorized_work",
        "classify_change_risk",
        "select_minimum_isolation_profile",
        "allocate_sandbox",
        "issue_scoped_credentials",
        "track_state",
        "record_evidence",
        "request_release_authorization"
      ]
    },
    {
      "id": "ephemeral-sandbox",
      "responsibilities": [
        "checkout_immutable_base",
        "create_isolated_worktree_or_branch",
        "run_build",
        "run_tests",
        "run_local_services",
        "run_browser_e2e_when_available",
        "collect_artifacts",
        "emit_execution_receipt",
        "destroy_after_completion"
      ]
    },
    {
      "id": "credential-broker",
      "responsibilities": [
        "prefer_short_lived_federated_identity",
        "provide_short_lived_scoped_credentials",
        "deny_secret_export",
        "revoke_on_completion_or_failure"
      ]
    },
    {
      "id": "evidence-store",
      "responsibilities": [
        "persist_execution_receipts",
        "persist_test_results",
        "persist_logs",
        "persist_build_metadata",
        "persist_verification_results",
        "persist_artifact_digests_and_provenance",
        "persist_release_and_rollback_evidence"
      ]
    },
    {
      "id": "release-gateway",
      "responsibilities": [
        "accept_only_verified_artifacts",
        "enforce_change_class_gate",
        "enforce_virtualization_receipt_gate",
        "promote_to_staging",
        "verify_staging",
        "request_or_consume_release_authorization",
        "promote_to_production",
        "verify_production",
        "trigger_safe_recovery_on_failed_verification"
      ]
    }
  ],
  "changeClasses": {
    "green": {
      "defaultAutonomy": "delegated",
      "minimumIsolationProfile": "standard",
      "productionPromotion": "through-release-gateway"
    },
    "yellow": {
      "defaultAutonomy": "delegated-with-contract-and-rollback",
      "minimumIsolationProfile": "standard",
      "escalateIsolationWhenUntrusted": "hardened",
      "productionPromotion": "through-release-gateway"
    },
    "red": {
      "defaultAutonomy": "prepare-only",
      "execution": "explicit-sovereign-human-gate-before-any-mutating-execution",
      "productionPromotion": "explicit-sovereign-human-gate"
    }
  },
  "executionLifecycle": [
    "observe",
    "classify",
    "authorize",
    "select_isolation_profile",
    "allocate",
    "checkout",
    "implement",
    "test",
    "verify",
    "repair_if_needed",
    "reverify",
    "package_immutable_artifact",
    "emit_execution_receipt",
    "open_or_update_pull_request",
    "ci_guard",
    "staging_promotion",
    "staging_verification",
    "release_authorization",
    "production_promotion",
    "production_verification",
    "recover_if_needed",
    "record_evidence",
    "learn"
  ],
  "safety": {
    "networkDefault": "deny-by-default-except-declared-egress",
    "filesystemDefault": "ephemeral-workspace-only",
    "rootFilesystemReadOnly": true,
    "privilegedContainerForbidden": true,
    "hostDockerSocketForbidden": true,
    "hostContainerSocketForbidden": true,
    "productionSecretsInSandboxForbidden": true,
    "persistentAgentShellForbidden": true,
    "persistentHostRepositoryExecutionForbidden": true,
    "destructiveProductionDataOperationsForbidden": true,
    "authorityExpansionForbidden": true,
    "noNewPrivilegesRequired": true,
    "capabilitiesDroppedByDefault": true,
    "resourceLimitsRequired": true
  },
  "costPolicy": {
    "target": "zero-or-low-fixed-cost-at-S0",
    "strategy": [
      "reuse-existing-github-and-cloud-capabilities",
      "prefer-single-small-control-plane",
      "prefer-ephemeral-compute",
      "shut-down-idle-workers",
      "measure-before-dedicated-capacity",
      "do-not-require-dedicated-microvm-infrastructure-until-risk-or-load-justifies-it"
    ]
  },
  "evidenceRequiredBeforeActivation": [
    "sandbox_isolation_test",
    "credential_scope_test",
    "green_change_end_to_end_test",
    "yellow_change_rollback_test",
    "red_change_human_gate_test",
    "staging_verification_test",
    "production_verification_test",
    "automatic_recovery_test",
    "audit_trail_test",
    "cost_budget_test"
  ],
  "evidenceProgress": {
    "sandbox_isolation_test": "proven_phase1_rootless_provider",
    "red_change_human_gate_test": "proven_in_runtime_contract",
    "credential_scope_test": "pending_runtime_provider_evidence",
    "green_change_end_to_end_test": "pending_full_change_to_pr_evidence",
    "yellow_change_rollback_test": "pending_runtime_rollback_evidence",
    "staging_verification_test": "pending",
    "production_verification_test": "pending",
    "automatic_recovery_test": "pending",
    "audit_trail_test": "partial_execution_receipt_contract",
    "cost_budget_test": "pending_measured_evidence"
  },
  "activation": {
    "currentState": "execution_runtime_phase1_proven_production_not_ready",
    "rule": "Do not claim autonomous production readiness until every required activation evidence item is satisfied with runtime evidence.",
    "owner": "EKODI Platform Super Administrator"
  }
}
