{
  "version": "1.8.2",
  "effectiveDate": "2026-09-06",
  "status": "active",
  "title": "EKODI Platform Constitution",
  "principles": [
    "free-first-not-free-only",
    "ekodi-core-is-source-of-truth",
    "provider-independent-by-default",
    "secure-by-default",
    "cache-first-for-public",
    "queue-first-for-heavy-work",
    "no-public-origin",
    "one-domain-grammar",
    "modular-monolith-first",
    "isolated-parallel-development",
    "verification-first-evolution",
    "security-native-intelligence",
    "evidence-linked-recommendations",
    "secure-projection-minimum-disclosure",
    "integrated-responsibility-distributed-execution-standardized-connections",
    "layered-governance-os-core-services-connections-workspaces",
    "user-surface-engine-separation",
    "capability-first-reuse",
    "sustainable-scale-by-evidence",
    "workspace-over-space",
    "living-digital-commons-north-star",
    "sovereign-autonomy-with-human-authority",
    "person-workspace-role-capability-authority",
    "observe-detect-reason-plan-execute-verify-recover-learn"
  ],
  "architectureModel": {
    "registry": "governance/architecture/ekodi-os-architecture.json",
    "platformBoundaryRegistry": "platform-boundaries.json",
    "evolutionRegistry": "governance/architecture/ekodi-evolution-model.json",
    "deploymentTopology": "modular-monolith-first",
    "layers": [
      "governance",
      "os",
      "core",
      "responsible-independent-service",
      "external-connected-service",
      "workspace"
    ],
    "responsibilityClasses": [
      "ekodi-responsible",
      "external-provider-responsible"
    ],
    "rule": "Modular monolith defines default deployment topology; explicit service responsibility and capability contracts define independent service boundaries. New independent deployment requires the sustainable boundary-creation gate.",
    "operatingArchitectureVersion": "1.8.1",
    "sovereignOperationsRegistry": "governance/architecture/sovereign-autonomous-operations.v1.json"
  },
  "systemBoundaries": {
    "production": [
      "ekodi.kr",
      "my.ekodi.kr",
      "admin.ekodi.kr",
      "auth.ekodi.kr",
      "api.ekodi.kr",
      "status.ekodi.kr",
      "ai.ekodi.kr",
      "dev.ekodi.kr",
      "exp.ekodi.kr"
    ],
    "development": [
      "my.dev.ekodi.kr",
      "admin.dev.ekodi.kr",
      "auth.dev.ekodi.kr",
      "api.dev.ekodi.kr"
    ],
    "rule": "User-operated spaces live under ekodi.kr paths. Subdomains are reserved for justified system, security, protocol, common-service or core-service boundaries and never define workspace identity."
  },
  "publicNamespaces": [
    "workspace-root-slug"
  ],
  "canonicalWorkspacePatterns": [
    "https://ekodi.kr/{slug}"
  ],
  "organizationSubtypes": [
    "business",
    "church",
    "school",
    "nonprofit",
    "association",
    "institution"
  ],
  "privateWorkspacePattern": "https://my.ekodi.kr/w/{workspace}",
  "featurePatterns": [
    "https://ekodi.kr/{feature}",
    "https://my.ekodi.kr/{feature}",
    "https://api.ekodi.kr/v1/{feature}"
  ],
  "workspaceRoutingPolicy": {
    "canonicalHost": "ekodi.kr",
    "identityKey": "workspace_id",
    "slugIsLocatorOnly": true,
    "workspaceSubdomainsForbidden": true,
    "personalHomeSubdomainException": "my.ekodi.kr",
    "kindEncodedInUrl": false,
    "reservedRootSlugsManagedBy": "platform_route_registry",
    "canonicalOperatingTerm": "Workspace",
    "legacySpaceIsCompatibilityOnly": true
  },
  "domainPolicy": {
    "newFeatureSubdomainsForbidden": true,
    "newTenantSubdomainsForbidden": true,
    "commonOrCoreServiceSubdomainsRequireGovernanceRegistration": true,
    "sustainableBoundaryGateRequired": true,
    "customDomainsMapToTenantPublicSpace": true,
    "legacyAliasesMayRedirect": true,
    "legacyAliasesMustBeRegistered": true,
    "userFacingEngineAddressesForbidden": true
  },
  "legacyPathAliases": {
    "https://space.ekodi.kr/{slug}": "https://ekodi.kr/{slug}",
    "https://user.ekodi.kr/{slug}": "https://ekodi.kr/{slug}"
  },
