  "virtualizationSovereigntyPolicy": {
    "id": "VIRTUALIZATION-SOVEREIGNTY-001",
    "status": "enforced",
    "orchestrationOwner": "ekodi-orchestrator",
    "scope": [
      "browser-ui-validation",
      "synthetic-surface-verification",
