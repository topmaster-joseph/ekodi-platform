{
  "version": "1.5.0",
  "effectiveDate": "2026-09-03",
  "status": "active",
  "title": "EKODI Platform Constitution",
  "principles": [
    "free-first-not-free-only",
    "ekodi-core-is-source-of-truth",
    "provider-independent-by-default",
    "secure-by-default",
    "cache-first-for-public",
    "queue-first-for-heavy-work",
    "no-public-origin",
    "one-domain-grammar",
    "modular-monolith-first",
    "isolated-parallel-development",
    "verification-first-evolution",
    "security-native-intelligence",
    "evidence-linked-recommendations",
    "secure-projection-minimum-disclosure",
    "service-local-admin-entrypoints"
  ],
  "systemBoundaries": {
    "production": [
      "ekodi.kr",
      "my.ekodi.kr",
      "admin.ekodi.kr",
      "auth.ekodi.kr",
      "api.ekodi.kr",
      "status.ekodi.kr"
    ],
    "development": [
      "dev.ekodi.kr",
      "my.dev.ekodi.kr",
      "admin.dev.ekodi.kr",
      "auth.dev.ekodi.kr",
      "api.dev.ekodi.kr"
    ],
    "rule": "User-operated spaces live under ekodi.kr paths. Subdomains are reserved for justified system, security, protocol, common-service or core-service boundaries and never define workspace identity."
  },
  "publicNamespaces": [
    "personal",
    "org",
    "group",
    "project"
  ],
  "canonicalWorkspacePatterns": [
    "https://ekodi.kr/personal/{slug}",
    "https://ekodi.kr/org/{slug}",
    "https://ekodi.kr/group/{slug}",
    "https://ekodi.kr/project/{slug}"
  ],
  "organizationSubtypes": [
    "business",
    "church",
    "school",
    "nonprofit",
    "association",
    "institution"
  ],
  "privateWorkspacePattern": "https://my.ekodi.kr/w/{workspace}",
  "featurePatterns": [
    "https://ekodi.kr/{feature}",
    "https://my.ekodi.kr/{feature}",
    "https://api.ekodi.kr/v1/{feature}"
  ],
  "workspaceRoutingPolicy": {
    "canonicalHost": "ekodi.kr",
    "identityKey": "workspace_id",
    "slugIsLocatorOnly": true,
    "workspaceSubdomainsForbidden": true,
    "personalHomeSubdomainException": "my.ekodi.kr"
  },
  "domainPolicy": {
    "newFeatureSubdomainsForbidden": true,
    "newTenantSubdomainsForbidden": true,
    "commonOrCoreServiceSubdomainsRequireGovernanceRegistration": true,
    "customDomainsMapToTenantPublicSpace": true,
    "legacyAliasesMayRedirect": true,
    "legacyAliasesMustBeRegistered": true
  },
  "legacyPathAliases": {
    "/people/{slug}": "/personal/{slug}",
    "/biz/{slug}": "/org/{slug}",
    "https://space.ekodi.kr/{path}": "https://ekodi.kr/{path}",
    "https://user.ekodi.kr/{path}": "https://ekodi.kr/{path}"
  },
  "legacyDomainAllowlist": [
    "shell.ekodi.kr",
    "management.ekodi.kr",
    "mall.ekodi.kr",
    "mall.biz.ekodi.kr",
    "cafe.ekodi.kr",
    "books.ekodi.kr",
    "publishing.ekodi.kr",
    "community.ekodi.kr",
    "work.ekodi.kr",
    "edu.ekodi.kr",
    "bible.ekodi.kr",
    "life.ekodi.kr",
    "support.ekodi.kr",
    "money.ekodi.kr",
    "social.ekodi.kr",
    "energy.ekodi.kr",
    "business.ekodi.kr",
    "finance-api.ekodi.kr",
    "drive.ekodi.kr",
    "marketing-api.ekodi.kr",
    "marketing-publish-api.ekodi.kr",
    "www.ekodi.kr",
    "pay.ekodi.kr",
    "trade.ekodi.kr",
    "mail.ekodi.kr",
    "live.ekodi.kr",
    "biz.ekodi.kr",
    "church.ekodi.kr",
    "lab.ekodi.kr",
    "mail.*.ekodi.kr",
    "marketing.ekodi.kr",
    "cgma.ekodi.kr",
    "cgma.ai.ekodi.kr",
    "jadam.ai.ekodi.kr",
    "pizzamaru.ai.ekodi.kr",
    "yogurt.ai.ekodi.kr",
    "space.ekodi.kr",
    "user.ekodi.kr"
  ],
  "dataSovereignty": {
    "ekodiCoreOwns": [
      "users",
      "identity_links",
      "tenants",
      "workspaces",
      "memberships",
      "roles",
      "permissions",
      "crm",
      "orders",
      "payments",
      "service_config",
      "automation",
      "audit_log"
    ],
    "humanCollaborationDocuments": "google_workspace_or_user_selected_provider",
    "systemObjects": "r2_or_s3_compatible",
    "structuredOperationalData": "ekodi_controlled_database",
    "providerMetadataOnlyMayBeCanonical": true,
    "providerMustNotOwnEkodiIdentityOrAuthorization": true
  },
  "providerPolicy": {
    "googleWorkspaceRole": "collaboration_provider",
    "cloudflareRole": "edge_and_system_object_provider",
    "aiProvidersRole": "replaceable_compute_provider",
    "directExternalProviderCallsFromFeatureModulesForbiddenWhenGatewayExists": true,
    "degradedProviderMustNotCollapseUnrelatedCoreServices": true
  },
  "securityPolicy": {
    "edgeBeforeOrigin": true,
    "publicOriginForbidden": true,
    "publicDatabaseForbidden": true,
    "adminRequiresStrongAccessBoundary": true,
    "protectedApiChain": [
      "authentication",
      "tenant_resolution",
      "authorization",
      "rate_limit",
      "validation",
      "business_logic"
    ],
    "heavyWorkUsesQueue": true,
    "publicCachePreferred": true,
    "privateAndAdminCacheRestricted": true,
    "secureProjection": {
      "enabledByDefault": true,
      "model": "purpose-bound-minimum-disclosure",
      "browserHiddenFieldsForbidden": true,
      "secretsNeverProjected": true,
      "sourceTopologyNotProjectedToBrowserOrExternalOperationalAi": true,
      "adminDefaultProfile": "admin_safe",
      "userSelfProfile": "user_self",
      "workspaceMemberProfile": "workspace_member",
      "experienceProfile": "experience_public",
      "externalAiDefaultProfile": "ai_minimum",
      "viewExportDownloadApiRawDataSeparated": true
    }
  },
  "parallelDevelopmentPolicy": {
    "appliesTo": [
      "Claude Code",
      "ChatGPT",
      "GPT",
      "Codex",
      "Gemini",
      "GitHub Copilot",
      "other AI development agents",
      "human developers"
    ],
    "uniqueTaskIdRequired": true,
    "independentBranchPerTask": true,
    "independentWorktreeOrSandboxPerTask": true,
    "sharedMutableWorkingDirectoryForbidden": true,
    "directProtectedBranchWritesForbidden": true,
    "directAgentProductionDeploymentForbidden": true,
    "centralPipeline": [
      "validation",
      "review",
      "merge",
      "guarded-deployment",
      "production-verification"
    ],
    "productionCredentialsOutsideAgentWorktrees": true
  },
  "changeControl": {
    "C0": "operational parameter change; no constitutional impact; automated validation allowed",
    "C1": "backward-compatible implementation change; CI validation required",
    "C2": "constitutional or topology policy amendment; explicit owner confirmation, amendment record, version bump and rollback plan required",
    "C3": "breaking domain/security/data architecture change; explicit owner confirmation, migration plan, staged rollout and rollback proof required",
    "protectedPaths": [
      "CONSTITUTION.md",
      "governance/constitution/**",
      "governance/amendments/**",
      "platform-boundaries.json",
      "config/core-data-boundaries.json",
      "config/storage-policy.json",
      "config/service-workspace-policy.json",
      "scripts/validate-constitution.mjs",
      ".github/workflows/constitution-check.yml"
    ],
    "owner": "topmaster-joseph",
    "rule": "C2/C3 changes are proposed first and applied only after explicit owner confirmation."
  },
  "legacyDomainTargets": {
    "shell.ekodi.kr": "https://my.ekodi.kr",
    "management.ekodi.kr": "https://my.ekodi.kr/management",
    "mall.ekodi.kr": "https://ekodi.kr/mall",
    "mall.biz.ekodi.kr": "https://ekodi.kr/mall",
    "cafe.ekodi.kr": "https://ekodi.kr/cafe",
    "books.ekodi.kr": "https://ekodi.kr/books",
    "publishing.ekodi.kr": "https://ekodi.kr/publish",
    "community.ekodi.kr": "https://ekodi.kr/community",
    "work.ekodi.kr": "https://ekodi.kr/work",
    "edu.ekodi.kr": "https://ekodi.kr/education",
    "bible.ekodi.kr": "https://ekodi.kr/bible",
    "life.ekodi.kr": "https://ekodi.kr/life",
    "support.ekodi.kr": "https://ekodi.kr/support",
    "money.ekodi.kr": "https://ekodi.kr/money",
    "social.ekodi.kr": "https://ekodi.kr/social",
    "energy.ekodi.kr": "https://ekodi.kr/energy",
    "business.ekodi.kr": "https://ekodi.kr/business",
    "finance-api.ekodi.kr": "https://api.ekodi.kr/v1/finance",
    "drive.ekodi.kr": "https://my.ekodi.kr/files",
    "marketing-api.ekodi.kr": "https://api.ekodi.kr/v1/marketing/domains",
    "marketing-publish-api.ekodi.kr": "https://api.ekodi.kr/v1/marketing/publish",
    "www.ekodi.kr": "https://ekodi.kr",
    "pay.ekodi.kr": "https://ekodi.kr/pay",
    "trade.ekodi.kr": "https://ekodi.kr/trade",
    "mail.ekodi.kr": "https://my.ekodi.kr/mail",
    "live.ekodi.kr": "https://ekodi.kr/live",
    "biz.ekodi.kr": "https://ekodi.kr/org/ekodi-biz",
    "church.ekodi.kr": "https://ekodi.kr/org/ekodi-church",
    "lab.ekodi.kr": "https://ekodi.kr/org/ekodi-lab",
    "mail.*.ekodi.kr": "https://my.ekodi.kr/mail",
    "marketing.ekodi.kr": "https://ekodi.kr/marketing",
    "cgma.ekodi.kr": "https://ekodi.kr/org/cgma",
    "cgma.ai.ekodi.kr": "https://ekodi.kr/org/cgma",
    "jadam.ai.ekodi.kr": "https://ekodi.kr/org/jadam",
    "pizzamaru.ai.ekodi.kr": "https://ekodi.kr/org/pizzamaru",
    "yogurt.ai.ekodi.kr": "https://ekodi.kr/org/yogurt",
    "space.ekodi.kr": "https://ekodi.kr",
    "user.ekodi.kr": "https://ekodi.kr"
  },
  "registeredCommonServiceBoundaries": [
    "journal.ekodi.kr"
  ],
  "evolutionPolicy": {
    "mode": "verification_first_security_native_self_evolving",
    "finalAuthority": "ekodi_platform_super_administrator",
    "providerIndependent": true,
    "evidenceLinksRequiredForPublishedRecommendations": true,
    "unsupportedRecommendationsRemainInternal": true,
    "externalAndInternalEvidenceCombined": true,
    "observedSignals": [
      "traffic",
      "latency",
      "error_rate",
      "capacity",
      "database",
      "queue",
      "cache",
      "storage",
      "network",
      "ai_cost",
      "security_events",
      "operational_load"
    ],
    "approvalRequired": [
      "production_change",
      "shared_core_creation",
      "permission_expansion",
      "paid_cost_commitment",
      "data_migration",
      "destructive_change",
      "security_boundary_change",
      "production_dns_change",
      "provider_lock_in"
    ],
    "securityCore": [
      "least_privilege",
      "zero_trust",
      "strong_authn_authz",
      "secret_management",
      "encryption",
      "audit",
      "tenant_isolation",
      "sandbox",
      "supply_chain_verification",
      "agent_identity",
      "tool_boundary",
      "data_boundary",
      "anomaly_detection",
      "automatic_isolation",
      "rollback",
      "backup",
      "disaster_recovery",
      "secure_projection"
    ]
  },
  "serviceAdministrationPolicy": {
    "canonicalServiceAdminPath": "/admin",
    "centralControlOrigin": "https://admin.ekodi.kr",
    "appliesTo": "independently_managed_common_core_and_user_facing_service_subdomains_with_operator_ui",
    "serviceEntryIsAuthoritySource": false,
    "authorizationSource": "ekodi_core_rbac",
    "authenticationBoundary": "central_auth_or_equivalent_strong_admin_boundary",
    "allowedDeliveryModes": [
      "central_admin_handoff",
      "protected_service_local_projection"
    ],
    "privateAndAdminCachePolicy": "no-store",
    "privilegedCoreHosts": [
      "api.ekodi.kr",
      "auth.ekodi.kr"
    ],
    "privilegedCoreExposure": "central-only unless a separately approved security boundary exists",
    "workspaceIdentityFromHostnameForbidden": true
  }
}
