      "DEPLOYED_AWAITING_SYSTEM_VERIFICATION",
      "VERIFICATION_EXCEPTION",
      "FAILED"
    ],
    "exceptionPolicy": {
      "defaultNonBlockingHumanDeviceEvidence": true,
      "exceptionMustBeNarrowScopedAuditableAndOwnerVisible": true,
      "exceptionRequiresUnsimulatableDeviceOsProviderBehaviorOrTelemetryConflict": true
    },
    "failurePolicy": {
      "repairRetestRedeployReverifyBeforeCompletion": true,
      "askUserToTestAsDefaultFallbackForbidden": true,
      "permissionFailureMustNotBeMistakenForPublicSurfaceSuccess": true
    },
    "finalAuthority": "ekodi_platform_super_administrator",
    "responsiveContentIntegrity": {
      "mandatory": true,
