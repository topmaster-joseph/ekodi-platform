  "dataSovereignty": {
    "ekodiCoreOwns": [
      "users",
      "identity_links",
      "tenants",
      "workspaces",
      "memberships",
      "roles",
      "permissions",
      "crm",
      "orders",
      "payments",
      "service_config",
      "automation",
      "audit_log"
    ],
    "humanCollaborationDocuments": "google_workspace_or_user_selected_provider",
    "systemObjects": "r2_or_s3_compatible",
    "structuredOperationalData": "ekodi_controlled_database",
    "providerMetadataOnlyMayBeCanonical": true,
    "providerMustNotOwnEkodiIdentityOrAuthorization": true
  },
  "providerPolicy": {
    "googleWorkspaceRole": "collaboration_provider",
    "cloudflareRole": "edge_and_system_object_provider",
    "aiProvidersRole": "replaceable_compute_provider",
    "directExternalProviderCallsFromFeatureModulesForbiddenWhenGatewayExists": true,
    "degradedProviderMustNotCollapseUnrelatedCoreServices": true,
    "paidCapacityRequiresMeasuredValueOrRequiredRiskControl": true,
    "speculativeScaleForbidden": true
  },
  "securityPolicy": {
    "edgeBeforeOrigin": true,
    "publicOriginForbidden": true,
    "publicDatabaseForbidden": true,
    "adminRequiresStrongAccessBoundary": true,
    "protectedApiChain": [
      "authentication",
      "tenant_resolution",
      "authorization",
      "rate_limit",
      "validation",
      "business_logic"
    ],
    "heavyWorkUsesQueue": true,
    "publicCachePreferred": true,
    "privateAndAdminCacheRestricted": true,
    "secureProjection": {
      "enabledByDefault": true,
      "model": "purpose-bound-minimum-disclosure",
      "browserHiddenFieldsForbidden": true,
      "secretsNeverProjected": true,
      "sourceTopologyNotProjectedToBrowserOrExternalOperationalAi": true,
      "adminDefaultProfile": "admin_safe",
      "userSelfProfile": "user_self",
      "workspaceMemberProfile": "workspace_member",
      "experienceProfile": "experience_public",
      "externalAiDefaultProfile": "ai_minimum",
      "viewExportDownloadApiRawDataSeparated": true
    }
  },
  "parallelDevelopmentPolicy": {
    "appliesTo": [
      "Claude Code",
      "ChatGPT",
      "GPT",
      "Codex",
      "Gemini",
      "GitHub Copilot",
      "other AI development agents",
      "human developers"
    ],
    "uniqueTaskIdRequired": true,
    "independentBranchPerTask": true,
    "independentWorktreeOrSandboxPerTask": true,
    "sharedMutableWorkingDirectoryForbidden": true,
    "directProtectedBranchWritesForbidden": true,
    "directAgentProductionDeploymentForbidden": true,
    "centralPipeline": [
      "validation",
      "review",
      "merge",
      "guarded-deployment",
      "production-verification"
    ],
    "productionCredentialsOutsideAgentWorktrees": true,
    "parallelSurfaceTracks": [
      "ui",
      "service",
      "tenant",
      "knowledge",
      "content",
      "agent"
    ],
    "sovereignRedAreasRequireCentralGate": true
  },
  "changeControl": {
    "C0": "operational parameter change; no constitutional impact; automated validation allowed",
    "C1": "backward-compatible implementation change; CI validation required",
    "C2": "constitutional or topology policy amendment; explicit owner confirmation, amendment record, version bump and rollback plan required",
    "C3": "breaking domain/security/data architecture change; explicit owner confirmation, migration plan, staged rollout and rollback proof required",
    "protectedPaths": [
      "CONSTITUTION.md",
      "governance/constitution/**",
      "governance/amendments/**",
      "governance/architecture/ekodi-evolution-model.json",
      "platform-boundaries.json",
      "config/core-data-boundaries.json",
      "config/storage-policy.json",
      "config/service-workspace-policy.json",
      "scripts/validate-constitution.mjs",
      "scripts/validate-ekodi-os-architecture.mjs",
      ".github/workflows/constitution-check.yml",
      "governance/architecture/sovereign-autonomous-operations.v1.json",
      "config/sovereign-surface-policy.json",
      "sovereign-autonomy-runtime.js",
      "scripts/validate-sovereign-autonomous-operations.mjs"
    ],
    "owner": "topmaster-joseph",
    "rule": "C2/C3 changes are proposed first and applied only after explicit owner confirmation."
  },
