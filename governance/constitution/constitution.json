    "currentGeneration": 2,
    "currentGenerationName": "Integrated Platform",
    "nextGeneration": 3,
    "nextGenerationName": "Capability Platform",
    "northStarGeneration": 8,
    "northStarName": "Living Digital Commons",
    "generationAdvancement": "evidence_driven_not_date_driven",
    "currentScaleTier": "S0",
    "defaultEconomics": "minimum-viable-shared-infrastructure",
    "reuseCapabilityBeforeNewService": true,
    "sharedBeforeDedicated": true,
    "existingDeploymentBoundariesGrandfathered": true,
