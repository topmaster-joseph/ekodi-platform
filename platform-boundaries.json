{
  "version": 1,
  "principle": "A platform change deploys only that platform unless a declared shared dependency changes.",
  "platforms": {
    "ekodi-shell": {"kind":"shared-person-context-layer","source":["ekodi-service-manifest.js","ekodi-shell-worker.js","ekodi-shell-injector.js","shell/**","wrangler.shell.toml","wrangler.shell.staging.toml","test/ekodi-shell.test.mjs"],"domains":["shell.ekodi.kr","ekodi-shell-staging.topmaster-joseph.workers.dev"],"deployWorkflow":".github/workflows/deploy-ekodi-shell.yml","sharedDependencies":["My EKODI workspace selection","central auth workspace handoff"],"database":"none","note":"Public service manifest plus navigation context only. Authorization remains server-side in each owning service."},
    "my": {"kind":"personal-control-layer","source":["my/**","my-worker.js","wrangler.my.toml","wrangler.my.staging.toml"],"domains":["my.ekodi.kr","ekodi-my-staging.topmaster-joseph.workers.dev"],"deployWorkflow":".github/workflows/deploy-my.yml","sharedDependencies":["Supabase Auth","central auth hub","ekodi-shell"],"database":"Supabase person/workspace views and person-scoped portfolio data"},
    "mall": {"kind":"independent-platform","source":["sites/ekodi-mall/**"],"domains":["mall.ekodi.kr","mall.biz.ekodi.kr","ekodi-mall.pages.dev"],"deployWorkflow":".github/workflows/deploy-ekodi-mall.yml","sharedDependencies":["service-proxy","ekodi-shell"],"database":"none"},
    "books": {"kind":"independent-platform","source":["books/**","books-worker.js","wrangler.books.toml"],"domains":["books.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-books.yml","sharedDependencies":["control-api for operational APIs"],"database":"ekodi-auth D1 via control-api"},
    "community": {"kind":"independent-platform","source":["community/**","community-worker.js","wrangler.community.toml"],"domains":["community.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-community.yml","sharedDependencies":["Supabase Auth","community-api","ekodi-shell"],"database":"Supabase community_* table namespace"},
    "work": {"kind":"independent-platform","source":["work/**","work-worker.js","wrangler.work.toml","wrangler.work-staging.toml","supabase/work-*.sql","tests/work-db-integration.sql"],"domains":["work.ekodi.kr","ekodi-work-staging.topmaster-joseph.workers.dev"],"deployWorkflow":".github/workflows/deploy-work.yml","sharedDependencies":["Supabase Auth","central auth hub"],"database":"Supabase work_* table namespace"},
    "social": {"kind":"independent-platform","source":["social/**","social-worker.js","wrangler.social.toml","wrangler.social-staging.toml"],"domains":["social.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-social.yml","sharedDependencies":["control-api Social registry","public social provider APIs"],"database":"ekodi-auth D1 via control-api with bundled static registry fallback"},
    "energy": {"kind":"independent-platform","source":["energy/**","energy-worker.js","wrangler.energy.toml","wrangler.energy-staging.toml","test/energy-platform.test.mjs","deploy/manifests/energy.worker.json"],"domains":["energy.ekodi.kr","ekodi-energy-staging.topmaster-joseph.workers.dev"],"deployWorkflow":".github/workflows/deploy-energy.yml","sharedDependencies":["future device adapters via explicit energy integration contracts only"],"database":"none in first release; future energy_* namespace"},
    "business": {"kind":"independent-platform","source":["business/**","business-worker.js","wrangler.business.toml","wrangler.business-staging.toml","test/business-os-platform.test.mjs","deploy/manifests/business.worker.json"],"domains":["business.ekodi.kr","ekodi-business-staging.topmaster-joseph.workers.dev"],"deployWorkflow":".github/workflows/deploy-business.yml","sharedDependencies":["central auth hub","Marketing AI via public service contract","Work via public service contract","Finance API via explicit contract when enabled","Energy AI via public service contract"],"database":"none in first release; future business_* namespace"},
    "finance": {"kind":"independent-service","source":["finance-worker.js","finance-entry-worker.js","wrangler.finance.toml"],"domains":["finance-api.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-finance.yml","sharedDependencies":["ekodi-auth D1"],"database":"ekodi-auth D1 with finance_* table namespace"},
    "control-api": {"kind":"shared-control-plane","source":["api-worker.js","auth-worker.js","customer-*.js","mission-control-entry-worker.js","security-edge.js","ai-agent-control.js","ai-governance-runtime.js","config/ai-mission-governance.json","membership-billing.js","admin-google-auth.js","books-control.js","books-finance-control.js","affiliate-control.js","social-registry-api.js","migrations/**"],"domains":["api.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-control-api.yml","sharedDependencies":["ekodi-auth D1","AI mission governance","Cloudflare edge rate limiting","Toss Payments recurring billing when configured"],"database":"ekodi-auth D1"},
    "marketing-domain-api": {"kind":"independent-service","source":["marketing-domain-control.js","marketing-domain-worker.js","wrangler.marketing-domains.toml","test/marketing-custom-domain.test.mjs","deploy/manifests/marketing-domain-api.worker.json"],"domains":["marketing-api.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-marketing-domain-api.yml","sharedDependencies":["ekodi-auth D1","Supabase Auth","Cloudflare Pages API","control-api membership subscription data"],"database":"ekodi-auth D1 with marketing_* table namespace"},
    "marketing-publishing-api": {"kind":"independent-service","source":["marketing-publishing-worker.js","wrangler.marketing-publishing.toml","wrangler.marketing-publishing.staging.toml","test/marketing-publishing.test.mjs","deploy/manifests/marketing-publishing.worker.json"],"domains":["marketing-publish-api.ekodi.kr","ekodi-marketing-publishing-staging.topmaster-joseph.workers.dev"],"deployWorkflow":".github/workflows/deploy-marketing-publishing.yml","sharedDependencies":["ekodi-auth D1","Supabase Auth","AI mission governance","official channel APIs through explicit user-authorized credentials"],"database":"ekodi-auth D1 with marketing_brand_profiles and marketing_publication_* namespaces"},
    "admin-auth": {"kind":"shared-control-plane-ui","source":["control-center*","compact-control-center*","client-access*","google-admin-auth*","finance-monitor.js","books-admin*","books-finance-admin*","marketing-funnel-admin*","social-admin*","auth-site/**"],"domains":["admin.ekodi.kr","auth.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-admin-site.yml","sharedDependencies":["shared-site-worker","control-api membership contract"],"database":"none"},
    "site-core": {"kind":"shared-edge-runtime","source":["site-worker.js","index.html","hub.html","trade.html","styles.css","script.js","responsive.css","scripts/build.mjs","wrangler.site.toml"],"domains":["ekodi.kr","www.ekodi.kr","pay.ekodi.kr","trade.ekodi.kr","mail.ekodi.kr","live.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-site-core.yml","sharedDependencies":[],"database":"none","note":"Temporary shared Worker. Split by domain family in isolation v2."},
    "service-proxy": {"kind":"shared-edge-proxy","source":["service-proxy.js","wrangler.service-proxy.toml"],"domains":["biz.ekodi.kr","church.ekodi.kr","lab.ekodi.kr","mall.ekodi.kr","mail.*.ekodi.kr"],"deployWorkflow":".github/workflows/deploy-service-proxy.yml","sharedDependencies":["mall Pages","church Pages","lab Pages","ekodi-shell"],"database":"none","note":"Proxy changes are shared-edge changes and require regression verification of every routed domain."},
    "marketing-ai": {"kind":"independent-platform-family","source":["marketing/**","customer-sites/**","marketing-*","client-*"],"domains":["marketing.ekodi.kr","cgma.ekodi.kr","cgma.ai.ekodi.kr","jadam.ai.ekodi.kr","pizzamaru.ai.ekodi.kr","yogurt.ai.ekodi.kr"],"deployWorkflow":".github/workflows/sync-marketing-ai.yml","sharedDependencies":["control-api customer authentication","control-api membership and billing","marketing-domain-api Pro custom-domain mapping","marketing-publishing-api for immediate and scheduled distribution"],"database":"platform-specific external storage and control-api tenant data"}
  },
  "rules": [
    "The full ecosystem deploy is manual-only.",
    "Platform workflows must use path filters.",
    "Shared edge runtimes must use a shared concurrency group to prevent overlapping production deploys.",
    "A shared database migration is a shared-core change and may intentionally trigger more than one service verification.",
    "No platform may read or write another tenant's private data without an explicit shared API contract.",
    "Production verification must use the real public hostname.",
    "Every new user-facing EKODI site must register in ekodi-service-manifest.js and consume the shared EKODI Shell or an equivalent reviewed Shell adapter.",
    "Browser workspace context is navigation context only; protected services must re-authorize Person + Space + Role server-side."
  ]
}
