/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; img-src data:; script-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
  Cache-Control: public, max-age=300, s-maxage=86400, stale-while-revalidate=604800

/ops/health.json
  ! Cache-Control
  Cache-Control: no-store
  Access-Control-Allow-Origin: *

/ekodibiz/ekodimall
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; connect-src 'self' https://renzehysxirjilvdxacv.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
  Cache-Control: no-cache

/auth-bootstrap.js
  Cache-Control: no-store

/auth-entry.js
  Cache-Control: no-store

/auth-router.js
  Cache-Control: no-store

/client-auth.js
  Cache-Control: no-store

/auth-workspace-target.js
  Cache-Control: no-store

/admin-auth.js
  Cache-Control: no-store

/admin/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; script-src 'self' https://accounts.google.com/gsi/client; img-src 'self' data:; connect-src 'self' https://renzehysxirjilvdxacv.supabase.co https://api.github.com https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/ https://ekodi.kr; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  ! Cache-Control
  Cache-Control: no-store
  X-EKODI-Route: admin-shell
  X-Robots-Tag: noindex, nofollow, noarchive
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; script-src 'self' https://accounts.google.com/gsi/client; img-src 'self' data:; connect-src 'self' https://renzehysxirjilvdxacv.supabase.co https://api.github.com https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/ https://ekodi.kr; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  ! Cache-Control
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow, noarchive
  Cross-Origin-Opener-Policy: same-origin-allow-popups
