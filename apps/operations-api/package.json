{
  "name": "@ekodi/operations-api",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc --project test/tsconfig.json --noEmit",
    "deploy": "wrangler deploy --config wrangler.toml",
    "migrate:production": "wrangler d1 migrations apply ekodi-auth --remote --config wrangler.toml",
    "test": "node --experimental-strip-types --test test/worker.test.mjs && vitest run --config vitest.config.ts",
    "test:unit": "node --experimental-strip-types --test test/worker.test.mjs",
    "test:integration": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ekodi/auth": "workspace:*",
    "@ekodi/database": "workspace:*",
    "@ekodi/ecosystem-catalog": "workspace:*",
    "@ekodi/ekcms": "workspace:*",
    "hono": "4.13.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.2",
    "@cloudflare/workers-types": "5.20260804.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
